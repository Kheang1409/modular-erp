{
  "ConnectionStrings": { "Postgres": "Host=localhost;Port=5432;Database=erp;Username=erp;Password=erp_local_only" },
  "Database": { "MigrateOnStartup": false },
  "DataProtection": { "KeysPath": ".erp/keys" },
  "Security": { "RequireSecureCookies": false },
  "ReverseProxy": { "KnownProxies": [] },
  "FileStorage": { "Provider": "Local", "LocalRootPath": ".erp/files", "MaximumFileSizeBytes": 26214400 },
  "BackgroundJobs": { "Enabled": true, "PollIntervalSeconds": 2, "LeaseSeconds": 60 },
  "Outbox": { "Enabled": true, "PollIntervalSeconds": 2, "LeaseSeconds": 60, "MaxAttempts": 10 },
  "Modules": {
    "ExternalPath": "modules/external",
    "Trust": { "RequireSignatures": false, "TrustedKeysPath": ".erp/trusted-publishers" }
  },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*"
}
