@page "/manufacturing/capacity"
@attribute [Authorize(Policy = ManufacturingPermissions.Read)]
@inject HttpClient Http
<PageTitle>Production capacity</PageTitle>
<article class="card entity-page module-workspace"><div class="page-heading"><div><p class="eyebrow">Manufacturing</p><h1>Production capacity</h1><p class="muted">Set available labor hours per day used to plan released production.</p></div></div>
@if(_error is not null){<div class="notice notice-error" role="alert">@_error</div>}@if(_message is not null){<div class="notice notice-success" role="status">@_message</div>}
<section class="module-panel"><h2>Daily labor capacity</h2>@if(_capacity is null){<p role="status">Loading capacity—</p>}else{<p class="muted">Current capacity: @_capacity.HoursPerDay.ToString("N2") hours per day.</p><AuthorizeView Policy="@ManufacturingPermissions.WorkOrderManage" Context="capacityManage"><EditForm Model="_form" OnValidSubmit="SaveAsync" FormName="capacity-save"><div class="form-grid"><label>Available labor hours per day<InputNumber @bind-Value="_form.HoursPerDay" min="0.01" step="0.25"/></label></div><button type="submit" disabled="@_saving">Save capacity</button></EditForm></AuthorizeView>}</section>
<section class="module-panel"><h2>Planning note</h2><p>Released orders reserve component stock and consume scheduled labor hours across planned dates. Capacity is used to validate that labor availability.</p><a class="button button-secondary" href="/manufacturing/work-orders">Review work orders</a></section>
</article>
@code {private ProductionCapacityDto? _capacity;private string? _error,_message;private bool _saving;private CapacityForm _form=new();protected override async Task OnInitializedAsync(){try{_capacity=await Http.GetFromJsonAsync<ProductionCapacityDto>("api/v1/manufacturing/capacity");if(_capacity is not null)_form.HoursPerDay=_capacity.HoursPerDay;}catch(HttpRequestException){_error="Production capacity could not be loaded.";}}private async Task SaveAsync(){if(_capacity is null)return;_saving=true;_error=null;try{using var response=await Http.PutAsJsonAsync("api/v1/manufacturing/capacity",new SetProductionCapacityRequest(_form.HoursPerDay,_capacity.ConcurrencyStamp));if(!response.IsSuccessStatusCode){_error="Capacity could not be saved. Refresh and try again.";return;}_capacity=await response.Content.ReadFromJsonAsync<ProductionCapacityDto>();_message="Daily capacity saved.";}catch(HttpRequestException){_error="Capacity could not be saved.";}finally{_saving=false;}}private sealed class CapacityForm{public decimal HoursPerDay{get;set;}=8;}}

