@page "/manufacturing/work-orders"
@attribute [Authorize(Policy = ManufacturingPermissions.Read)]
@inject HttpClient Http
<PageTitle>Work orders</PageTitle>
<article class="card entity-page module-workspace">
    <div class="page-heading"><div><p class="eyebrow">Manufacturing</p><h1>Work orders</h1><p class="muted">Plan production, manage job status, record actual costs, and capture quality checks.</p></div></div>
@if(_error is not null){<div class="notice notice-error" role="alert">@_error</div>}@if(_message is not null){<div class="notice notice-success" role="status">@_message</div>}
    <AuthorizeView Policy="@ManufacturingPermissions.WorkOrderManage" Context="createAccess"><section class="module-panel"><h2>Create work order</h2>@if(!_bills.Any(x=>x.State==BillOfMaterialState.Active)){<p class="muted">Activate a bill of materials before creating an order.</p>}else{<EditForm Model="_draft" OnValidSubmit="CreateAsync" FormName="work-order-create"><div class="form-grid"><label>Order number<InputText @bind-Value="_draft.Number" maxlength="50"/></label><label>Active bill<InputSelect @bind-Value="_draft.BillId"><option value="@Guid.Empty">Choose a bill</option>@foreach(var b in _bills.Where(x=>x.State==BillOfMaterialState.Active)){<option value="@b.Id">@b.Number — @b.ProductSku / @b.Revision</option>}</InputSelect></label><label>Quantity<InputNumber @bind-Value="_draft.Quantity" min="0.0001" step="0.0001"/></label><label>Planned labor hours<InputNumber @bind-Value="_draft.LaborHours" min="0.01" step="0.25"/></label><label>Cost currency<InputText @bind-Value="_draft.Currency" maxlength="3"/></label><label>Inventory location<InputSelect @bind-Value="_draft.LocationId"><option value="@Guid.Empty">Choose internal location</option>@foreach(var loc in _locations){<option value="@loc.Id">@loc.Code — @loc.Name</option>}</InputSelect></label><label>Planned start<InputDate @bind-Value="_draft.Start"/></label><label>Planned end<InputDate @bind-Value="_draft.End"/></label><label>Notes<InputText @bind-Value="_draft.Notes" maxlength="2000"/></label></div><button type="submit" disabled="@_saving">Create work order</button></EditForm>}</section></AuthorizeView>
    <section class="module-panel"><div class="section-heading"><div><h2>Work order register</h2><p class="muted">Select a row to view history and quality inspections.</p></div><button type="button" class="button button-secondary" @onclick="LoadAsync">Refresh</button></div>
    @if(_loading){<p role="status">Loading work orders—</p>}else if(_orders.Count==0){<p class="empty-state">No work orders found.</p>}else{<div class="table-scroll" tabindex="0"><table class="data-table"><thead><tr><th>Number</th><th>Product</th><th>Planned quantity</th><th>Dates</th><th>Material estimate</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var o in _orders){<tr @key="o.Id"><td><button class="button button-secondary button-small" aria-pressed="@(_selected?.Id==o.Id)" @onclick="()=>SelectAsync(o)">@o.Number</button></td><td>@o.ProductSku — @o.ProductName</td><td>@o.PlannedQuantity @o.UnitCode</td><td>@o.PlannedStartDate — @o.PlannedEndDate</td><td>@o.CostCurrencyCode @o.PlannedMaterialCost.ToString("N2")</td><td>@o.State</td><td><AuthorizeView Policy="@ManufacturingPermissions.WorkOrderTransition" Context="transitionAccess">@foreach(var next in NextStates(o.State)){<button class="button button-secondary button-small" disabled="@_saving" @onclick="()=>Transition(o,next)">@Label(next)</button>}</AuthorizeView></td></tr>}}</tbody></table></div>}
    </section>
    @if(_selected is not null){<section class="module-panel"><h2>@_selected.Number details</h2><p class="muted">@_selected.ProductSku — @_selected.ProductName — @_selected.State</p>
        @if(_selected.State is WorkOrderState.Draft or WorkOrderState.Released or WorkOrderState.InProgress){<h3>Material availability</h3>@if(_materialsLoading){<p role="status">Checking component stock...</p>}else if(_materials.Count==0){<p class="muted">No material requirements were returned for this work order.</p>}else{<div class="table-scroll" tabindex="0"><table class="data-table"><thead><tr><th>Component</th><th>Required</th><th>On hand</th><th>Reserved</th><th>For this order</th><th>Available</th><th>Shortage</th></tr></thead><tbody>@foreach(var m in _materials){<tr @key="m.ProductId"><td>@m.ProductSku — @m.ProductName</td><td>@m.RequiredQuantity</td><td>@m.OnHand</td><td>@m.Reserved</td><td>@m.ReservedForWorkOrder</td><td>@m.Available</td><td>@if(m.Shortage>0){<strong class="text-danger">@m.Shortage</strong>}else{<span>0</span>}</td></tr>}</tbody></table></div>}}
        @if(_selected.State==WorkOrderState.InProgress){<AuthorizeView Policy="@ManufacturingPermissions.WorkOrderTransition" Context="completeAccess"><EditForm Model="_actual" OnValidSubmit="CompleteAsync" FormName="work-order-complete"><div class="form-grid"><label>Actual output quantity<InputNumber @bind-Value="_actual.Output" min="0.0001" step="0.0001"/></label><label>Actual labor hours<InputNumber @bind-Value="_actual.Labor" min="0" step="0.25"/></label><label>Actual material cost<InputNumber @bind-Value="_actual.Material" min="0" step="0.01"/></label><label>Actual labor cost<InputNumber @bind-Value="_actual.LaborCost" min="0" step="0.01"/></label><label>Actual overhead cost<InputNumber @bind-Value="_actual.Overhead" min="0" step="0.01"/></label></div><button type="submit" disabled="@_saving">Complete production</button></EditForm></AuthorizeView>}
        @if(_selected.State is WorkOrderState.InProgress or WorkOrderState.Completed){<AuthorizeView Policy="@ManufacturingPermissions.QualityManage" Context="qualityAccess"><h3>Record inspection</h3><EditForm Model="_inspection" OnValidSubmit="CreateInspectionAsync" FormName="inspection-create"><div class="form-grid"><label>Inspection number<InputText @bind-Value="_inspection.Number" maxlength="50"/></label><label>Sample quantity<InputNumber @bind-Value="_inspection.Quantity" min="0.0001" step="0.0001"/></label><label>Decision<InputSelect @bind-Value="_inspection.Decision">@foreach(var d in Enum.GetValues<InspectionDecision>()){<option value="@d">@d</option>}</InputSelect></label><label>Inspector<InputText @bind-Value="_inspection.Inspector" maxlength="200"/></label><label>Notes<InputText @bind-Value="_inspection.Notes" maxlength="2000"/></label></div><button type="submit">Save inspection</button></EditForm></AuthorizeView>}
        <h3>Status history</h3>@if(_history.Count==0){<p class="muted">No status changes recorded.</p>}else{<ol>@foreach(var h in _history){<li>@h.ChangedAtUtc.ToLocalTime(): @h.FromState ? @h.ToState @h.Notes</li>}</ol>}
        <h3>Quality inspections</h3>@if(_inspections.Count==0){<p class="muted">No inspections recorded.</p>}else{<div class="table-scroll" tabindex="0"><table class="data-table"><thead><tr><th>Number</th><th>Inspected</th><th>Sample</th><th>Decision</th><th>Inspector</th><th>Notes</th></tr></thead><tbody>@foreach(var i in _inspections){<tr><td>@i.Number</td><td>@i.InspectedAtUtc.ToLocalTime().ToString("g")</td><td>@i.SampleQuantity</td><td>@i.Decision</td><td>@i.Inspector</td><td>@i.Notes</td></tr>}</tbody></table></div>}
    </section>}
</article>
@code {
    private List<BillOfMaterialResponse> _bills=[];private List<WorkOrderResponse> _orders=[];private List<LocationOption> _locations=[];private List<WorkOrderMaterialAvailabilityResponse> _materials=[];private List<QualityInspectionResponse> _inspections=[];private List<WorkOrderStatusChangeResponse> _history=[];private WorkOrderResponse? _selected;private string? _error,_message;private bool _loading=true,_saving,_materialsLoading;private OrderDraft _draft=new();private ActualDraft _actual=new();private InspectionDraft _inspection=new();
    protected override async Task OnInitializedAsync(){try{_bills=await Http.GetFromJsonAsync<List<BillOfMaterialResponse>>("api/v1/manufacturing/bills-of-material")??[];_locations=(await Http.GetFromJsonAsync<List<LocationOption>>("api/v1/inventory/locations")??[]).Where(x=>x.Type=="Internal"&&x.IsActive).ToList();}catch(HttpRequestException){_error="Bill or inventory choices could not be loaded. Check read permissions.";}await LoadAsync();}
    private async Task LoadAsync(){_loading=true;try{_orders=await Http.GetFromJsonAsync<List<WorkOrderResponse>>("api/v1/manufacturing/work-orders")??[];if(_selected is not null){_selected=_orders.FirstOrDefault(x=>x.Id==_selected.Id);if(_selected is not null)await LoadDetailsAsync(_selected.Id);}}catch(HttpRequestException){_error="Work orders could not be loaded.";_orders=[];}finally{_loading=false;}}
    private async Task SelectAsync(WorkOrderResponse o){_selected=o;_materials=[];_actual=new(){Output=o.PlannedQuantity,Labor=o.PlannedLaborHours,Material=o.PlannedMaterialCost};_inspection=new();await LoadDetailsAsync(o.Id);}
    private async Task LoadDetailsAsync(Guid id){try{_history=await Http.GetFromJsonAsync<List<WorkOrderStatusChangeResponse>>($"api/v1/manufacturing/work-orders/{id}/status-history")??[];_inspections=await Http.GetFromJsonAsync<List<QualityInspectionResponse>>($"api/v1/manufacturing/work-orders/{id}/inspections")??[];_materialsLoading=true;_materials=await Http.GetFromJsonAsync<List<WorkOrderMaterialAvailabilityResponse>>($"api/v1/manufacturing/work-orders/{id}/materials")??[];}catch(HttpRequestException){_error="Work order details could not be loaded.";}finally{_materialsLoading=false;}}
    private async Task CreateAsync(){if(_draft.BillId==Guid.Empty||_draft.LocationId==Guid.Empty){_error="Select an active bill and internal production location.";return;}await SaveAsync(()=>Http.PostAsJsonAsync("api/v1/manufacturing/work-orders",new CreateWorkOrderRequest(_draft.Number,_draft.BillId,_draft.Quantity,_draft.Start,_draft.End,_draft.Notes,_draft.LocationId,_draft.LaborHours,_draft.Currency)),"Work order created.",true);}
    private async Task Transition(WorkOrderResponse o,WorkOrderState state){var req=new ChangeWorkOrderStateRequest(state,null,o.ConcurrencyStamp);await SaveAsync(()=>Http.PostAsJsonAsync($"api/v1/manufacturing/work-orders/{o.Id}/transition",req),$"Work order moved to {state}.");}
    private async Task CompleteAsync(){if(_selected is null)return;var req=new ChangeWorkOrderStateRequest(WorkOrderState.Completed,null,_selected.ConcurrencyStamp,_actual.Output,_actual.Labor,_actual.Material,_actual.LaborCost,_actual.Overhead);await SaveAsync(()=>Http.PostAsJsonAsync($"api/v1/manufacturing/work-orders/{_selected.Id}/transition",req),"Production completed.");}
    private async Task CreateInspectionAsync(){if(_selected is null)return;await SaveAsync(()=>Http.PostAsJsonAsync($"api/v1/manufacturing/work-orders/{_selected.Id}/inspections",new CreateQualityInspectionRequest(_inspection.Number,_inspection.Quantity,_inspection.Decision,DateTimeOffset.UtcNow,_inspection.Inspector,_inspection.Notes)),"Inspection recorded.");}
    private async Task SaveAsync(Func<Task<HttpResponseMessage>> action,string success,bool reset=false){_saving=true;_error=null;try{using var response=await action();if(!response.IsSuccessStatusCode){_error="The action was rejected. Check permissions and the current order state.";return;}if(reset)_draft=new();_message=success;await LoadAsync();}catch(HttpRequestException){_error="The request could not be completed.";}finally{_saving=false;}}
    private static IReadOnlyList<WorkOrderState> NextStates(WorkOrderState s)=>s switch{WorkOrderState.Draft=>[WorkOrderState.Released,WorkOrderState.Cancelled],WorkOrderState.Released=>[WorkOrderState.InProgress,WorkOrderState.Cancelled],WorkOrderState.InProgress=>[WorkOrderState.Completed,WorkOrderState.Cancelled],_=>[]};private static string Label(WorkOrderState s)=>s switch{WorkOrderState.Released=>"Release",WorkOrderState.InProgress=>"Start",WorkOrderState.Completed=>"Complete",WorkOrderState.Cancelled=>"Cancel",_=>s.ToString()};
    private sealed record LocationOption(Guid Id,Guid? WarehouseId,string Code,string Name,string Type,bool IsActive,string ConcurrencyStamp);
    private sealed class OrderDraft{public string? Number{get;set;}public Guid BillId{get;set;}public decimal Quantity{get;set;}=1;public decimal LaborHours{get;set;}=8;public string Currency{get;set;}="USD";public Guid LocationId{get;set;}public DateOnly? Start{get;set;}public DateOnly? End{get;set;}public string? Notes{get;set;}}
    private sealed class ActualDraft{public decimal Output{get;set;}=1;public decimal? Labor{get;set;}public decimal? Material{get;set;}public decimal? LaborCost{get;set;}public decimal? Overhead{get;set;}}
    private sealed class InspectionDraft{public string? Number{get;set;}public decimal Quantity{get;set;}=1;public InspectionDecision Decision{get;set;}=InspectionDecision.Accepted;public string? Inspector{get;set;}public string? Notes{get;set;}}
}


