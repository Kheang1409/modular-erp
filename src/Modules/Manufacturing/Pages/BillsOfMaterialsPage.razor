@page "/manufacturing/bills"
@attribute [Authorize(Policy = ManufacturingPermissions.Read)]
@inject HttpClient Http
<PageTitle>Bills of materials</PageTitle>
<article class="card entity-page module-workspace">
    <div class="page-heading"><div><p class="eyebrow">Manufacturing</p><h1>Bills of materials</h1><p class="muted">Define the components and standard costs required for each finished product.</p></div></div>
@if(_error is not null){<div class="notice notice-error" role="alert">@_error</div>}
    @if(_message is not null){<div class="notice notice-success" role="status">@_message</div>}
    <AuthorizeView Policy="@ManufacturingPermissions.BillOfMaterialManage" Context="bomManage"><section class="module-panel"><h2>Create a bill of materials</h2>
        @if(_products.Count<2){<p class="muted">At least two active inventory tracked products are needed.</p>}else{
        <EditForm Model="_draft" OnValidSubmit="CreateAsync" FormName="bom-create"><DataAnnotationsValidator/><div class="form-grid">
            <label>Bill number<InputText @bind-Value="_draft.Number" maxlength="50"/></label><label>Finished product<InputSelect @bind-Value="_draft.ProductId"><option value="@Guid.Empty">Choose a product</option>@foreach(var p in _products){<option value="@p.Id">@p.Sku — @p.Name (@p.SalesUnitCode)</option>}</InputSelect></label>
            <label>Revision<InputText @bind-Value="_draft.Revision" maxlength="30"/></label><label>Output quantity<InputNumber @bind-Value="_draft.OutputQuantity" min="0.0001" step="0.0001"/></label><label>Notes<InputText @bind-Value="_draft.Notes" maxlength="2000"/></label>
        </div><h3>Components</h3>@foreach(var line in _draft.Components){<div class="form-grid" @key="line"><label>Component<InputSelect @bind-Value="line.ProductId"><option value="@Guid.Empty">Choose a component</option>@foreach(var p in _products.Where(x=>x.Id!=_draft.ProductId)){<option value="@p.Id">@p.Sku — @p.Name (@p.SalesUnitCode)</option>}</InputSelect></label><label>Quantity per output<InputNumber @bind-Value="line.Quantity" min="0.0001" step="0.0001"/></label><label>Standard unit cost<InputNumber @bind-Value="line.UnitCost" min="0" step="0.01"/></label><label>Notes<InputText @bind-Value="line.Notes" maxlength="1000"/></label><button type="button" class="button button-secondary" disabled="@(_draft.Components.Count==1)" @onclick="()=>_draft.Components.Remove(line)">Remove</button></div>}<div class="form-actions"><button type="button" class="button button-secondary" @onclick="AddLine">Add component</button><button type="submit" disabled="@_saving">Save draft bill</button></div></EditForm>}
    </section></AuthorizeView>
    <section class="module-panel"><div class="section-heading"><div><h2>Bill register</h2><p class="muted">Draft bills can be activated; active bills can be retired.</p></div><button type="button" class="button button-secondary" @onclick="LoadAsync">Refresh</button></div>
    @if(_loading){<p role="status">Loading bills—</p>}else if(_bills.Count==0){<p class="empty-state">No bills of materials found.</p>}else{<div class="table-scroll" tabindex="0"><table class="data-table"><thead><tr><th>Number</th><th>Product</th><th>Revision</th><th>Output</th><th>Components</th><th>State</th><th>Actions</th></tr></thead><tbody>@foreach(var bill in _bills){<tr @key="bill.Id"><td>@bill.Number</td><td>@bill.ProductSku — @bill.ProductName</td><td>@bill.Revision</td><td>@bill.OutputQuantity @bill.OutputUnitCode</td><td>@bill.Components.Count</td><td>@bill.State</td><td>@if(bill.State==BillOfMaterialState.Draft){<AuthorizeView Policy="@ManufacturingPermissions.BillOfMaterialManage"><button class="button button-secondary button-small" disabled="@_saving" @onclick="()=>ChangeState(bill,true)">Activate</button></AuthorizeView>}else if(bill.State==BillOfMaterialState.Active){<AuthorizeView Policy="@ManufacturingPermissions.BillOfMaterialManage"><button class="button button-secondary button-small" disabled="@_saving" @onclick="()=>ChangeState(bill,false)">Retire</button></AuthorizeView>}</td></tr>}}</tbody></table></div>}
    </section>
</article>
@code {
    private readonly List<ProductOption> _products=[]; private List<BillOfMaterialResponse> _bills=[]; private string? _error,_message; private bool _loading=true,_saving; private BillDraft _draft=new();
    protected override async Task OnInitializedAsync(){try{var page=await Http.GetFromJsonAsync<ProductPage>("api/v1/products/?tracksInventory=true&pageSize=100");_products.AddRange(page?.Items.Where(x=>x.TracksInventory&&!x.IsArchived)??[]);}catch(HttpRequestException){_error="Product choices could not be loaded. Product read access is required.";}await LoadAsync();}
    private void AddLine()=>_draft.Components.Add(new());
    private async Task LoadAsync(){_loading=true;try{_bills=await Http.GetFromJsonAsync<List<BillOfMaterialResponse>>("api/v1/manufacturing/bills-of-material")??[];}catch(HttpRequestException){_error="Bills could not be loaded.";_bills=[];}finally{_loading=false;}}
    private async Task CreateAsync(){_error=null;if(_draft.ProductId==Guid.Empty||_draft.Components.Any(x=>x.ProductId==Guid.Empty)){_error="Choose a finished product and a product for each component.";return;}if(_draft.Components.Any(x=>x.ProductId==_draft.ProductId)){_error="A finished product cannot be one of its own components.";return;}var lines=_draft.Components.Select(x=>new BillOfMaterialLineRequest(x.ProductId,x.Quantity,_products.First(p=>p.Id==x.ProductId).SalesUnitCode,x.Notes,x.UnitCost)).ToArray();await Mutate(()=>Http.PostAsJsonAsync("api/v1/manufacturing/bills-of-material",new BillOfMaterialRequest(_draft.Number,_draft.ProductId,_draft.Revision,_draft.OutputQuantity,lines,_draft.Notes)),"Draft bill created.",true);}
    private async Task ChangeState(BillOfMaterialResponse bill,bool activate)=>await Mutate(()=>Http.PostAsJsonAsync($"api/v1/manufacturing/bills-of-material/{bill.Id}/{(activate?"activate":"retire")}",new SetBillOfMaterialStateRequest(bill.ConcurrencyStamp)),activate?"Bill activated.":"Bill retired.");
    private async Task Mutate(Func<Task<HttpResponseMessage>> action,string success,bool reset=false){_saving=true;_error=null;_message=null;try{using var response=await action();if(!response.IsSuccessStatusCode){_error="The change was rejected. Check the values and current record state.";return;}if(reset)_draft=new();_message=success;await LoadAsync();}catch(HttpRequestException){_error="The request could not be completed.";}finally{_saving=false;}}
    private sealed record ProductPage(IReadOnlyList<ProductOption> Items); private sealed record ProductOption(Guid Id,string Sku,string Name,string SalesUnitCode,bool TracksInventory,bool IsArchived);
    private sealed class BillDraft{public string? Number{get;set;}public Guid ProductId{get;set;}public string? Revision{get;set;}="A";public decimal OutputQuantity{get;set;}=1;public string? Notes{get;set;}public List<ComponentDraft> Components{get;}=[new()];}
    private sealed class ComponentDraft{public Guid ProductId{get;set;}public decimal Quantity{get;set;}=1;public decimal UnitCost{get;set;}public string? Notes{get;set;}}
}

