@page "/purchasing/orders"
@attribute [Authorize(Policy = PurchasingPermissions.Read)]
@inject IPurchaseOrderService Orders
<PageTitle>Purchase orders</PageTitle>
<article class="card contacts-card entity-page module-workspace">
    <div class="page-heading"><div><p class="eyebrow">Purchasing</p><h1>Purchase orders</h1><p class="muted">Create, review, and track supplier orders.</p></div><nav class="heading-actions" aria-label="Purchase order actions"><a class="button" href="/purchasing/orders/new">New purchase order</a></nav></div>
<section class="module-panel"><h2>Find an order</h2><EditForm Model="Filter" OnValidSubmit="Load" FormName="purchase-order-filter"><div class="form-grid"><label>Search <InputText @bind-Value="Filter.Search" /></label><button type="submit">Search</button></div></EditForm></section>
    <section class="module-panel"><h2>Order register</h2>
    @if (_page is null) { <p role="status">Loading purchase ordersï¿½</p> }
    else if (_page.Items.Count == 0) { <p class="empty-state">No purchase orders match this search.</p> }
    else { <div class="table-scroll" tabindex="0" role="region" aria-label="Purchase orders"><table class="data-table"><caption>Purchase orders</caption><thead><tr><th scope="col">Number</th><th scope="col">Supplier</th><th scope="col">State</th><th scope="col">Total</th></tr></thead><tbody>@foreach(var order in _page.Items){<tr><td><a href="@($"/purchasing/orders/{order.Id}")">@order.Number</a></td><td>@order.SupplierName</td><td>@order.State</td><td>@order.Total.ToString("N2") @order.CurrencyCode</td></tr>}</tbody></table></div><p class="muted">@_page.Total order(s)</p> }
    </section>
</article>
@code {private PurchaseOrderPage? _page;private FilterModel Filter{get;}=new();protected override Task OnInitializedAsync()=>Load();private async Task Load()=>_page=await Orders.SearchAsync(new(Filter.Search),CancellationToken.None);private sealed class FilterModel{public string? Search{get;set;}}}
