@page "/purchasing/orders/new"
@attribute [Authorize(Policy=PurchasingPermissions.Manage)]
@inject IPurchaseOrderService Orders
@inject Erp.Abstractions.Currencies.ICurrencyConfigurationService Currencies
@inject NavigationManager Navigation
<PageTitle>New purchase order</PageTitle><article class="card contacts-card"><h1>New purchase order</h1><PurchaseOrderEditor Model="Form" OnSubmit="Save" Busy="_busy" Error="@_error" FormName="new-purchase-order"/></article>
@code{private PurchaseOrderForm Form{get;}=new();private bool _busy;private string? _error;protected override async Task OnInitializedAsync(){var c=await Currencies.GetAsync(CancellationToken.None);Form.CurrencyCode=c.BaseCurrencyCode;}private async Task Save(){_busy=true;try{var x=await Orders.CreateAsync(Form.ToRequest(),CancellationToken.None);Navigation.NavigateTo($"/purchasing/orders/{x.Id}");}catch(Exception ex){_error=ex.Message;}finally{_busy=false;}}}
