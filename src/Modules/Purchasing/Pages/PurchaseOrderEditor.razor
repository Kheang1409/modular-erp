<EditForm Model="Model" OnValidSubmit="Submit" FormName="@FormName"><DataAnnotationsValidator/><ValidationSummary/><div class="form-grid"><label>Supplier ID <InputText @bind-Value="Model.SupplierId"/></label><label>Currency <InputText @bind-Value="Model.CurrencyCode"/></label><label>Order date <InputDate @bind-Value="Model.OrderDate"/></label><label>Expected delivery <InputDate @bind-Value="Model.ExpectedDeliveryDate"/></label><label class="wide">Notes <InputTextArea @bind-Value="Model.Notes"/></label></div><h2>Lines</h2>@for(var i=0;i<Model.Lines.Count;i++){var line=Model.Lines[i];<fieldset><legend>Line @(i+1)</legend><div class="form-grid"><label>Product ID <InputText @bind-Value="line.ProductId"/></label><label>Quantity <InputNumber @bind-Value="line.Quantity"/></label><label>Unit price <InputNumber @bind-Value="line.UnitPrice"/></label><label>Discount % <InputNumber @bind-Value="line.DiscountPercent"/></label><label>Tax % <InputNumber @bind-Value="line.TaxPercent"/></label><label>Description <InputText @bind-Value="line.Description"/></label></div>@if(Model.Lines.Count>1){<button type="button" @onclick="()=>Model.Lines.Remove(line)">Remove</button>}</fieldset>}<button type="button" @onclick="()=>Model.Lines.Add(new())">Add line</button> <button type="submit" disabled="@Busy">Save purchase order</button>@if(Error is not null){<p role="alert">@Error</p>}</EditForm>
@code{[Parameter,EditorRequired]public PurchaseOrderForm Model{get;set;}=new();[Parameter]public EventCallback OnSubmit{get;set;}[Parameter]public bool Busy{get;set;}[Parameter]public string? Error{get;set;}[Parameter]public string FormName{get;set;}="purchase-order";private Task Submit()=>OnSubmit.InvokeAsync();}
