@page "/purchasing/orders/{Id:guid}/cancel"
@attribute [Authorize(Policy=PurchasingPermissions.Cancel)]
@inject IPurchaseOrderService Orders
@inject NavigationManager Navigation
<PageTitle>Cancel purchase order</PageTitle><article class="card contacts-card"><h1>Cancel purchase order</h1>@if(_item is null){<p>Loading...</p>}else{<p>Cancel <strong>@_item.Number</strong>?</p><button @onclick="Apply">Cancel</button>@if(_error is not null){<p role="alert">@_error</p>}}</article>
@code{[Parameter]public Guid Id{get;set;}private PurchaseOrderDto? _item;private string? _error;protected override async Task OnParametersSetAsync()=>_item=await Orders.GetAsync(Id,CancellationToken.None);private async Task Apply(){try{await Orders.TransitionAsync(Id,PurchaseOrderState.Cancelled,_item!.ConcurrencyStamp,CancellationToken.None);Navigation.NavigateTo($"/purchasing/orders/{Id}");}catch(Exception ex){_error=ex.Message;}}}
