@page "/purchasing/orders/{Id:guid}"
@attribute [Authorize(Policy=PurchasingPermissions.Read)]
@inject IPurchaseOrderService Orders
<PageTitle>Purchase order</PageTitle>
<article class="card contacts-card">
    @if (_item is null)
    {
        <p>Loading...</p>
    }
    else
    {
        <p class="eyebrow">@_item.State</p><h1>@_item.Number</h1>
        <p>@_item.SupplierName · expected @_item.ExpectedDeliveryDate</p>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Purchase order lines">
            <table>
                <caption>Purchase order lines</caption>
                <thead><tr><th scope="col">Product</th><th scope="col">Quantity</th><th scope="col">Price</th><th scope="col">Total</th></tr></thead>
                <tbody>
                    @foreach (var line in _item.Lines)
                    {
                        <tr><td>@line.ProductSku — @line.Description</td><td>@line.Quantity @line.UnitCode</td><td>@line.UnitPrice</td><td>@line.Total</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <dl><dt>Subtotal</dt><dd>@_item.Subtotal</dd><dt>Discount</dt><dd>@_item.DiscountTotal</dd><dt>Tax</dt><dd>@_item.TaxTotal</dd><dt>Total</dt><dd><strong>@_item.Total @_item.CurrencyCode</strong></dd></dl>
        <p><a href="@($"/purchasing/orders/{Id}/edit")">Edit</a> <a href="@($"/purchasing/orders/{Id}/approve")">Send/confirm</a> <a href="@($"/purchasing/orders/{Id}/cancel")">Cancel</a> <a href="/purchasing/orders">Back</a></p>
    }
</article>
@code{[Parameter]public Guid Id{get;set;}private PurchaseOrderDto? _item;protected override async Task OnParametersSetAsync()=>_item=await Orders.GetAsync(Id,CancellationToken.None);}
