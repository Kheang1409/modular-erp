@page "/purchasing/orders/{Id:guid}"
@attribute [Authorize(Policy=PurchasingPermissions.Read)]
@inject IPurchaseOrderService Orders
<PageTitle>Purchase order</PageTitle><article class="card contacts-card">@if(_item is null){<p>Loading...</p>}else{<p class="eyebrow">@_item.State</p><h1>@_item.Number</h1><p>@_item.SupplierName · expected @_item.ExpectedDeliveryDate</p><table><thead><tr><th>Product</th><th>Quantity</th><th>Price</th><th>Total</th></tr></thead><tbody>@foreach(var l in _item.Lines){<tr><td>@l.ProductSku — @l.Description</td><td>@l.Quantity @l.UnitCode</td><td>@l.UnitPrice</td><td>@l.Total</td></tr>}</tbody></table><dl><dt>Subtotal</dt><dd>@_item.Subtotal</dd><dt>Discount</dt><dd>@_item.DiscountTotal</dd><dt>Tax</dt><dd>@_item.TaxTotal</dd><dt>Total</dt><dd><strong>@_item.Total @_item.CurrencyCode</strong></dd></dl><p><a href="@($"/purchasing/orders/{Id}/edit")">Edit</a> <a href="@($"/purchasing/orders/{Id}/approve")">Send/confirm</a> <a href="@($"/purchasing/orders/{Id}/cancel")">Cancel</a> <a href="/purchasing/orders">Back</a></p>}</article>
@code{[Parameter]public Guid Id{get;set;}private PurchaseOrderDto? _item;protected override async Task OnParametersSetAsync()=>_item=await Orders.GetAsync(Id,CancellationToken.None);}
