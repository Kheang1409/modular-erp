@baseUrl = https://localhost:7016
@employeeId = 11111111-1111-1111-1111-111111111111
@leaveRequestId = 22222222-2222-2222-2222-222222222222
@attendanceId = 33333333-3333-3333-3333-333333333333

### List employees
GET {{baseUrl}}/api/v1/hcm/employees

### Search employees
GET {{baseUrl}}/api/v1/hcm/employees?search=Alex

### Get employee
GET {{baseUrl}}/api/v1/hcm/employees/{{employeeId}}

### Create employee
POST {{baseUrl}}/api/v1/hcm/employees
Content-Type: application/json

{
  "employeeNumber": "EMP-1001",
  "fullName": "Alex Morgan",
  "email": "alex.morgan@example.com",
  "hireDate": "2026-01-15"
}

### Update employee
PUT {{baseUrl}}/api/v1/hcm/employees/{{employeeId}}
Content-Type: application/json

{
  "fullName": "Alex Morgan",
  "email": "alex.morgan@example.com",
  "hireDate": "2026-01-15",
  "status": "Active"
}

### List leave requests
GET {{baseUrl}}/api/v1/hcm/leave-requests?employeeId={{employeeId}}

### Get leave request
GET {{baseUrl}}/api/v1/hcm/leave-requests/{{leaveRequestId}}

### Submit leave request
POST {{baseUrl}}/api/v1/hcm/leave-requests
Content-Type: application/json

{
  "employeeId": "{{employeeId}}",
  "startDate": "2026-12-21",
  "endDate": "2026-12-23",
  "reason": "Personal leave"
}

### Approve leave request
POST {{baseUrl}}/api/v1/hcm/leave-requests/{{leaveRequestId}}/decision
Content-Type: application/json

{
  "decision": "Approved"
}

### List attendance
GET {{baseUrl}}/api/v1/hcm/attendance?employeeId={{employeeId}}&workDate=2026-11-08

### Get attendance record
GET {{baseUrl}}/api/v1/hcm/attendance/{{attendanceId}}

### Check in
POST {{baseUrl}}/api/v1/hcm/attendance/check-in
Content-Type: application/json

{
  "employeeId": "{{employeeId}}",
  "workDate": "2026-11-08",
  "checkedInAtUtc": "2026-11-08T08:00:00Z"
}

### Check out
POST {{baseUrl}}/api/v1/hcm/attendance/{{attendanceId}}/check-out
Content-Type: application/json

{
  "checkedOutAtUtc": "2026-11-08T16:30:00Z"
}

### List benefit enrollments
GET {{baseUrl}}/api/v1/hcm/employee-benefits?employeeId={{employeeId}}

### Get benefit enrollment
GET {{baseUrl}}/api/v1/hcm/employee-benefits/44444444-4444-4444-4444-444444444444

### Record benefit enrollment
POST {{baseUrl}}/api/v1/hcm/employee-benefits
Content-Type: application/json

{
  "employeeId": "{{employeeId}}",
  "benefitName": "Health coverage",
  "provider": "Example Benefits Co.",
  "enrollmentDate": "2026-01-15",
  "endDate": null
}

### Update benefit enrollment
PUT {{baseUrl}}/api/v1/hcm/employee-benefits/44444444-4444-4444-4444-444444444444
Content-Type: application/json

{
  "benefitName": "Health coverage",
  "provider": "Example Benefits Co.",
  "enrollmentDate": "2026-01-15",
  "endDate": "2026-11-08",
  "status": "Ended"
}

### List completed training
GET {{baseUrl}}/api/v1/hcm/training-records?employeeId={{employeeId}}

### Get completed training
GET {{baseUrl}}/api/v1/hcm/training-records/55555555-5555-5555-5555-555555555555

### Record completed training
POST {{baseUrl}}/api/v1/hcm/training-records
Content-Type: application/json

{
  "employeeId": "{{employeeId}}",
  "title": "Workplace safety",
  "provider": "Example Training",
  "completedOn": "2026-09-10",
  "expiresOn": "2027-09-10",
  "certificateReference": "SAFE-2026-1001"
}

### Update completed training
PUT {{baseUrl}}/api/v1/hcm/training-records/55555555-5555-5555-5555-555555555555
Content-Type: application/json

{
  "title": "Workplace safety",
  "provider": "Example Training",
  "completedOn": "2026-09-10",
  "expiresOn": "2027-09-10",
  "certificateReference": "SAFE-2026-1001"
}

### List performance reviews
GET {{baseUrl}}/api/v1/hcm/performance-reviews?employeeId={{employeeId}}

### Get performance review
GET {{baseUrl}}/api/v1/hcm/performance-reviews/66666666-6666-6666-6666-666666666666

### Record a performance review
POST {{baseUrl}}/api/v1/hcm/performance-reviews
Content-Type: application/json

{
  "employeeId": "{{employeeId}}",
  "reviewerName": "Jordan Lee",
  "periodStart": "2026-01-01",
  "periodEnd": "2026-06-30",
  "summary": "Consistently delivered agreed work and collaborated across teams.",
  "strengths": "Clear communication and reliable follow-through.",
  "developmentGoals": "Lead a cross-functional project in the next review period."
}

### Update a performance review
PUT {{baseUrl}}/api/v1/hcm/performance-reviews/66666666-6666-6666-6666-666666666666
Content-Type: application/json

{
  "reviewerName": "Jordan Lee",
  "periodStart": "2026-01-01",
  "periodEnd": "2026-06-30",
  "summary": "Consistently delivered agreed work and collaborated across teams.",
  "strengths": "Clear communication and reliable follow-through.",
  "developmentGoals": "Lead a cross-functional project in the next review period."
}
