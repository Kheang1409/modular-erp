@page "/hcm/reviews"
@using System.Net.Http.Json
@using Erp.Modules.Hcm.Contracts
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = HcmPermissions.PerformanceReviewsRead)]
@inject HttpClient Http
<PageTitle>Performance reviews</PageTitle><article class="card entity-page module-workspace"><div class="page-heading"><div><p class="eyebrow">People operations</p><h1>Performance reviews</h1><p class="muted">Record confidential review notes, strengths, and development goals.</p></div></div>
@if(_error is not null){<div class="notice notice-error" role="alert">@_error</div>}<AuthorizeView Context="auth0" Policy="@HcmPermissions.PerformanceReviewsManage"><section class="module-panel"><h2>Record a review</h2><EditForm Model="_form" OnValidSubmit="Create" FormName="review-create"><div class="form-grid"><label>Employee ID<InputText @bind-Value="_form.EmployeeId"/></label><label>Reviewer<InputText @bind-Value="_form.Reviewer"/></label><label>Period start<InputDate @bind-Value="_form.Start"/></label><label>Period end<InputDate @bind-Value="_form.End"/></label><label>Summary<InputTextArea @bind-Value="_form.Summary"/></label><label>Strengths<InputTextArea @bind-Value="_form.Strengths"/></label><label>Development goals<InputTextArea @bind-Value="_form.Goals"/></label></div><button type="submit">Save review</button></EditForm></section></AuthorizeView>
<section class="module-panel"><h2>Reviews</h2>@if(_items is null){<p role="status">Loading…</p>}else if(_items.Count==0){<p class="empty-state">No reviews recorded.</p>}else{<div class="table-scroll" tabindex="0"><table class="data-table"><thead><tr><th>Employee</th><th>Reviewer</th><th>Period</th><th>Summary</th><th>Strengths</th><th>Development</th></tr></thead><tbody>@foreach(var x in _items){<tr><td>@x.EmployeeName</td><td>@x.ReviewerName</td><td>@x.PeriodStart – @x.PeriodEnd</td><td>@x.Summary</td><td>@x.Strengths</td><td>@x.DevelopmentGoals</td></tr>}</tbody></table></div>}</section></article>
@code {private List<PerformanceReviewDto>? _items;private string? _error;private FormModel _form=new();protected override async Task OnInitializedAsync()=>await Load();private async Task Load(){try{_items=await Http.GetFromJsonAsync<List<PerformanceReviewDto>>("api/v1/hcm/performance-reviews")??[];}catch(HttpRequestException){_error="Could not load reviews.";_items=[];}}private async Task Create(){if(!Guid.TryParse(_form.EmployeeId,out var id)){_error="Enter a valid employee ID.";return;}try{var response=await Http.PostAsJsonAsync("api/v1/hcm/performance-reviews",new CreatePerformanceReviewRequest(id,_form.Reviewer,_form.Start,_form.End,_form.Summary,_form.Strengths,_form.Goals));if(!response.IsSuccessStatusCode){_error="The review was rejected.";return;}await Load();_form=new();}catch(HttpRequestException){_error="Could not save the review.";}}private sealed class FormModel{public string EmployeeId{get;set;}="";public string? Reviewer{get;set;}public DateOnly Start{get;set;}=DateOnly.FromDateTime(DateTime.Today.AddMonths(-6));public DateOnly End{get;set;}=DateOnly.FromDateTime(DateTime.Today);public string? Summary{get;set;}public string? Strengths{get;set;}public string? Goals{get;set;}}}


