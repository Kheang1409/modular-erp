@page "/hcm/leave"
@using System.Net.Http.Json
@using Erp.Modules.Hcm.Contracts
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = HcmPermissions.Read)]
@inject HttpClient Http
<PageTitle>Leave requests</PageTitle><article class="card entity-page module-workspace"><div class="page-heading"><div><p class="eyebrow">People operations</p><h1>Leave requests</h1><p class="muted">Submit time away and review pending decisions.</p></div></div>
@if(_error is not null){<div class="notice notice-error" role="alert">@_error</div>} @if(_notice is not null){<div class="notice notice-success" role="status">@_notice</div>}
<AuthorizeView Context="auth0" Policy="@HcmPermissions.Manage"><section class="module-panel"><h2>Submit a request</h2><EditForm Model="_form" OnValidSubmit="Submit" FormName="leave-submit"><DataAnnotationsValidator/><div class="form-grid"><label>Employee ID<InputText @bind-Value="_form.EmployeeId"/></label><label>Start date<InputDate @bind-Value="_form.Start"/></label><label>End date<InputDate @bind-Value="_form.End"/></label><label>Reason<InputText @bind-Value="_form.Reason"/></label></div><button type="submit" disabled="@_busy">Submit request</button></EditForm></section></AuthorizeView>
<section class="module-panel"><h2>Requests</h2>@if(_items is null){<p role="status">Loading requests…</p>}else if(_items.Count==0){<p class="empty-state">No leave requests.</p>}else{<div class="table-scroll" tabindex="0"><table class="data-table"><thead><tr><th>Employee</th><th>Dates</th><th>Reason</th><th>Status</th><th>Decision</th></tr></thead><tbody>@foreach(var x in _items){<tr><td>@x.EmployeeName</td><td>@x.StartDate – @x.EndDate</td><td>@x.Reason</td><td>@x.Status</td><td>@if(x.Status==LeaveRequestStatus.Pending){<AuthorizeView Context="auth0" Policy="@HcmPermissions.ApproveLeave"><button class="button button-secondary button-small" @onclick="()=>Decide(x.Id,LeaveRequestStatus.Approved)">Approve</button><button class="button button-secondary button-small" @onclick="()=>Decide(x.Id,LeaveRequestStatus.Rejected)">Reject</button></AuthorizeView>}</td></tr>}</tbody></table></div>}</section></article>
@code {private List<LeaveRequestDto>? _items;private string? _error,_notice;private bool _busy;private LeaveForm _form=new();protected override async Task OnInitializedAsync()=>await Load();private async Task Load(){try{_items=await Http.GetFromJsonAsync<List<LeaveRequestDto>>("api/v1/hcm/leave-requests")??[];}catch(HttpRequestException){_error="Requests could not be loaded.";_items=[];}}private async Task Submit(){if(!Guid.TryParse(_form.EmployeeId,out var id)){_error="Enter a valid employee ID.";return;}await Send("api/v1/hcm/leave-requests",new SubmitLeaveRequest(id,_form.Start,_form.End,_form.Reason));}private async Task Decide(Guid id,LeaveRequestStatus status)=>await Send($"api/v1/hcm/leave-requests/{id}/decision",new LeaveRequestDecision(status));private async Task Send<T>(string uri,T body){_busy=true;_error=null;try{var response=await Http.PostAsJsonAsync(uri,body);if(!response.IsSuccessStatusCode){_error="The request was rejected. Check its values and your access.";return;}_notice="Changes saved.";await Load();}catch(HttpRequestException){_error="The request could not be completed.";}finally{_busy=false;}}private sealed class LeaveForm{public string EmployeeId{get;set;}="";public DateOnly Start{get;set;}=DateOnly.FromDateTime(DateTime.Today);public DateOnly End{get;set;}=DateOnly.FromDateTime(DateTime.Today);public string? Reason{get;set;}}}


