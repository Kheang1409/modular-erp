@page "/hcm/training"
@using System.Net.Http.Json
@using Erp.Modules.Hcm.Contracts
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = HcmPermissions.TrainingRead)]
@inject HttpClient Http
<PageTitle>Training</PageTitle><article class="card entity-page module-workspace"><div class="page-heading"><div><p class="eyebrow">People operations</p><h1>Training</h1><p class="muted">Keep completed training and certificate details together.</p></div></div>
@if(_error is not null){<div class="notice notice-error" role="alert">@_error</div>}<AuthorizeView Context="auth0" Policy="@HcmPermissions.TrainingManage"><section class="module-panel"><h2>Add completed training</h2><EditForm Model="_form" OnValidSubmit="Create" FormName="training-create"><div class="form-grid"><label>Employee ID<InputText @bind-Value="_form.EmployeeId"/></label><label>Title<InputText @bind-Value="_form.Title"/></label><label>Provider<InputText @bind-Value="_form.Provider"/></label><label>Completed<InputDate @bind-Value="_form.Completed"/></label><label>Expires<InputDate @bind-Value="_form.Expires"/></label><label>Certificate reference<InputText @bind-Value="_form.Certificate"/></label></div><button type="submit">Add record</button></EditForm></section></AuthorizeView>
<section class="module-panel"><h2>Training records</h2>@if(_items is null){<p role="status">Loading…</p>}else if(_items.Count==0){<p class="empty-state">No training records.</p>}else{<div class="table-scroll" tabindex="0"><table class="data-table"><thead><tr><th>Employee</th><th>Title</th><th>Provider</th><th>Completed</th><th>Expires</th><th>Certificate</th></tr></thead><tbody>@foreach(var x in _items){<tr><td>@x.EmployeeName</td><td>@x.Title</td><td>@x.Provider</td><td>@x.CompletedOn</td><td>@x.ExpiresOn</td><td>@x.CertificateReference</td></tr>}</tbody></table></div>}</section></article>
@code {private List<TrainingRecordDto>? _items;private string? _error;private FormModel _form=new();protected override async Task OnInitializedAsync()=>await Load();private async Task Load(){try{_items=await Http.GetFromJsonAsync<List<TrainingRecordDto>>("api/v1/hcm/training-records")??[];}catch(HttpRequestException){_error="Could not load training records.";_items=[];}}private async Task Create(){if(!Guid.TryParse(_form.EmployeeId,out var id)){_error="Enter a valid employee ID.";return;}try{var r=await Http.PostAsJsonAsync("api/v1/hcm/training-records",new CreateTrainingRecordRequest(id,_form.Title,_form.Provider,_form.Completed,_form.Expires,_form.Certificate));if(!r.IsSuccessStatusCode){_error="The record was rejected.";return;}await Load();_form=new();}catch(HttpRequestException){_error="Could not save the record.";}}private sealed class FormModel{public string EmployeeId{get;set;}="";public string? Title{get;set;}public string? Provider{get;set;}public DateOnly Completed{get;set;}=DateOnly.FromDateTime(DateTime.Today);public DateOnly? Expires{get;set;}public string? Certificate{get;set;}}}


