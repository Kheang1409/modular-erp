@page "/hcm/attendance"
@using System.Net.Http.Json
@using Erp.Modules.Hcm.Contracts
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = HcmPermissions.Read)]
@inject HttpClient Http
<PageTitle>Attendance</PageTitle><article class="card entity-page module-workspace"><div class="page-heading"><div><p class="eyebrow">People operations</p><h1>Attendance</h1><p class="muted">Record daily check-ins and complete open attendance records.</p></div></div>
@if(_error is not null){<div class="notice notice-error" role="alert">@_error</div>} @if(_notice is not null){<div class="notice notice-success" role="status">@_notice</div>}
<AuthorizeView Context="auth0" Policy="@HcmPermissions.Manage"><section class="module-panel"><h2>Check in</h2><EditForm Model="_form" OnValidSubmit="CheckIn" FormName="attendance-checkin"><div class="form-grid"><label>Employee ID<InputText @bind-Value="_form.EmployeeId"/></label><label>Work date<InputDate @bind-Value="_form.WorkDate"/></label></div><button type="submit" disabled="@_busy">Record check-in</button></EditForm></section></AuthorizeView>
<section class="module-panel"><h2>Attendance records</h2>@if(_items is null){<p role="status">Loading attendance…</p>}else if(_items.Count==0){<p class="empty-state">No attendance records.</p>}else{<div class="table-scroll" tabindex="0"><table class="data-table"><thead><tr><th>Employee</th><th>Work date</th><th>Check-in UTC</th><th>Check-out UTC</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach(var x in _items){<tr><td>@x.EmployeeName</td><td>@x.WorkDate</td><td>@(x.CheckedInAtUtc?.ToString("HH:mm")??"—")</td><td>@(x.CheckedOutAtUtc?.ToString("HH:mm")??"Open")</td><td>@x.ApprovalStatus</td><td>@if(x.CheckedOutAtUtc is null){<AuthorizeView Context="auth0" Policy="@HcmPermissions.Manage"><button class="button button-secondary button-small" @onclick="()=>CheckOut(x.Id)">Check out</button></AuthorizeView>}</td></tr>}</tbody></table></div>}</section></article>
@code {private List<AttendanceRecordDto>? _items;private string? _error,_notice;private bool _busy;private CheckinForm _form=new();protected override async Task OnInitializedAsync()=>await Load();private async Task Load(){try{_items=await Http.GetFromJsonAsync<List<AttendanceRecordDto>>("api/v1/hcm/attendance")??[];}catch(HttpRequestException){_error="Attendance could not be loaded.";_items=[];}}private async Task CheckIn(){if(!Guid.TryParse(_form.EmployeeId,out var id)){_error="Enter a valid employee ID.";return;}await Send("api/v1/hcm/attendance/check-in",new CheckInRequest(id,_form.WorkDate,DateTimeOffset.UtcNow));}private async Task CheckOut(Guid id)=>await Send($"api/v1/hcm/attendance/{id}/check-out",new CheckOutRequest(DateTimeOffset.UtcNow));private async Task Send<T>(string uri,T body){_busy=true;_error=null;try{var response=await Http.PostAsJsonAsync(uri,body);if(!response.IsSuccessStatusCode){_error="The request was rejected. Check values and permissions.";return;}_notice="Attendance updated.";await Load();}catch(HttpRequestException){_error="The request could not be completed.";}finally{_busy=false;}}private sealed class CheckinForm{public string EmployeeId{get;set;}="";public DateOnly WorkDate{get;set;}=DateOnly.FromDateTime(DateTime.Today);}}


