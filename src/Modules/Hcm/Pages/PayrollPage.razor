@page "/hcm/payroll"
@using System.Net.Http.Json
@using Erp.Modules.Hcm.Contracts
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = HcmPermissions.PayrollRead)]
@inject HttpClient Http
<PageTitle>Payroll</PageTitle><article class="card entity-page module-workspace"><div class="page-heading"><div><p class="eyebrow">People operations</p><h1>Payroll</h1><p class="muted">Manage pay periods and review calculated payroll runs.</p></div></div>
@if(_error is not null){<div class="notice notice-error" role="alert">@_error</div>}
<AuthorizeView Context="auth0" Policy="@HcmPermissions.PayrollManage"><section class="module-panel"><h2>Create a payroll period</h2><EditForm Model="_form" OnValidSubmit="CreatePeriod" FormName="payroll-period-create"><div class="form-grid"><label>Number<InputText @bind-Value="_form.Number"/></label><label>Type<InputSelect @bind-Value="_form.Type">@foreach(var x in Enum.GetValues<PayrollPeriodType>()){<option value="@x">@x</option>}</InputSelect></label><label>Start<InputDate @bind-Value="_form.Start"/></label><label>End<InputDate @bind-Value="_form.End"/></label><label>Pay date<InputDate @bind-Value="_form.PayDate"/></label><label>Jurisdiction<InputText @bind-Value="_form.Jurisdiction"/></label></div><button type="submit">Create period</button></EditForm></section></AuthorizeView>
<section class="module-panel"><h2>Pay periods</h2>@if(_periods is null){<p role="status">Loading…</p>}else if(_periods.Count==0){<p class="empty-state">No periods.</p>}else{<div class="table-scroll" tabindex="0"><table class="data-table"><thead><tr><th>Number</th><th>Type</th><th>Dates</th><th>Pay date</th><th>Jurisdiction</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach(var p in _periods){<tr><td>@p.Number</td><td>@p.Type</td><td>@p.StartDate – @p.EndDate</td><td>@p.PayDate</td><td>@p.JurisdictionCode</td><td>@p.Status</td><td>@if(p.Status==PayrollPeriodStatus.Open){<AuthorizeView Context="auth0" Policy="@HcmPermissions.PayrollApprove"><button class="button button-secondary button-small" @onclick="()=>Close(p.Id)">Close</button></AuthorizeView>}<AuthorizeView Context="auth0" Policy="@HcmPermissions.PayrollManage"><button class="button button-secondary button-small" @onclick="()=>CreateRun(p.Id)">Create run</button></AuthorizeView></td></tr>}</tbody></table></div>}</section>
<section class="module-panel"><h2>Payroll runs</h2>@if(_runs is null){<p role="status">Loading…</p>}else if(_runs.Count==0){<p class="empty-state">No payroll runs.</p>}else{<div class="table-scroll" tabindex="0"><table class="data-table"><thead><tr><th>Run</th><th>Period</th><th>Pay date</th><th>Employees</th><th>Net pay</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach(var r in _runs){<tr><td>@r.Number</td><td>@r.PeriodStart – @r.PeriodEnd</td><td>@r.PayDate</td><td>@r.Lines.Count</td><td>@r.CurrencyCode @r.Lines.Sum(x=>x.NetPay).ToString("N2")</td><td>@r.Status</td><td>@if(r.Status==PayrollRunStatus.Draft){<AuthorizeView Context="auth0" Policy="@HcmPermissions.PayrollApprove"><button class="button button-secondary button-small" @onclick="()=>Transition(r,PayrollRunStatus.Approved)">Approve</button></AuthorizeView>}else if(r.Status==PayrollRunStatus.Approved){<AuthorizeView Context="auth0" Policy="@HcmPermissions.PayrollApprove"><button class="button button-secondary button-small" @onclick="()=>Transition(r,PayrollRunStatus.Paid)">Mark paid</button></AuthorizeView>}</td></tr>}</tbody></table></div>}</section></article>
@code {private List<PayrollPeriodDto>? _periods;private List<PayrollRunDto>? _runs;private string? _error;private PeriodForm _form=new();protected override async Task OnInitializedAsync()=>await Load();private async Task Load(){try{_periods=await Http.GetFromJsonAsync<List<PayrollPeriodDto>>("api/v1/hcm/payroll-periods")??[];_runs=await Http.GetFromJsonAsync<List<PayrollRunDto>>("api/v1/hcm/payroll-runs")??[];}catch(HttpRequestException){_error="Could not load payroll data.";_periods??=[];_runs??=[];}}private async Task CreatePeriod(){await Send("api/v1/hcm/payroll-periods",new PayrollPeriodRequest(_form.Number,_form.Type,_form.Start,_form.End,_form.PayDate,_form.Jurisdiction,null));}private async Task CreateRun(Guid id){await Send($"api/v1/hcm/payroll-periods/{id}/runs",new CreatePayrollRunRequest(null,Guid.NewGuid().ToString()));}private async Task Close(Guid id){try{using var response=await Http.PostAsync($"api/v1/hcm/payroll-periods/{id}/close",null);if(!response.IsSuccessStatusCode)_error="Could not close the period.";await Load();}catch(HttpRequestException){_error="Could not close the period.";}}private async Task Transition(PayrollRunDto run,PayrollRunStatus status){await Send($"api/v1/hcm/payroll-runs/{run.Id}/transition",new PayrollRunTransition(status,run.ConcurrencyStamp));}private async Task Send<T>(string uri,T body){try{using var response=await Http.PostAsJsonAsync(uri,body);if(!response.IsSuccessStatusCode)_error="Payroll action rejected.";await Load();}catch(HttpRequestException){_error="Payroll action failed.";}}private sealed class PeriodForm{public string? Number{get;set;}public PayrollPeriodType Type{get;set;}=PayrollPeriodType.Monthly;public DateOnly Start{get;set;}=DateOnly.FromDateTime(DateTime.Today);public DateOnly End{get;set;}=DateOnly.FromDateTime(DateTime.Today);public DateOnly PayDate{get;set;}=DateOnly.FromDateTime(DateTime.Today);public string? Jurisdiction{get;set;}}}


