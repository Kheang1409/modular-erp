@page "/hcm/benefits"
@using System.Net.Http.Json
@using Erp.Modules.Hcm.Contracts
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = HcmPermissions.BenefitsRead)]
@inject HttpClient Http
<PageTitle>Benefits</PageTitle><article class="card entity-page module-workspace"><div class="page-heading"><div><p class="eyebrow">People operations</p><h1>Benefits</h1><p class="muted">Track employee benefit enrollment and coverage dates.</p></div></div>
@if(_error is not null){<div class="notice notice-error" role="alert">@_error</div>}
<AuthorizeView Context="auth0" Policy="@HcmPermissions.BenefitsManage"><section class="module-panel"><h2>Record enrollment</h2><EditForm Model="_form" OnValidSubmit="Create" FormName="benefit-create"><div class="form-grid"><label>Employee ID<InputText @bind-Value="_form.EmployeeId"/></label><label>Benefit<InputText @bind-Value="_form.Name"/></label><label>Provider<InputText @bind-Value="_form.Provider"/></label><label>Enrollment date<InputDate @bind-Value="_form.Start"/></label><label>End date<InputDate @bind-Value="_form.End"/></label></div><button type="submit" disabled="@_busy">Record benefit</button></EditForm></section></AuthorizeView>
<section class="module-panel"><h2>Enrollments</h2>@if(_items is null){<p role="status">Loading…</p>}else if(_items.Count==0){<p class="empty-state">No enrollments.</p>}else{<div class="table-scroll" tabindex="0"><table class="data-table"><thead><tr><th>Employee</th><th>Benefit</th><th>Provider</th><th>Start</th><th>End</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach(var x in _items){<tr><td>@x.EmployeeName</td><td>@x.BenefitName</td><td>@x.Provider</td><td>@x.EnrollmentDate</td><td>@x.EndDate</td><td>@x.Status</td><td>@if(x.Status==BenefitEnrollmentStatus.Active){<AuthorizeView Context="auth0" Policy="@HcmPermissions.BenefitsManage"><button class="button button-secondary button-small" @onclick="()=>End(x)">End</button></AuthorizeView>}</td></tr>}</tbody></table></div>}</section></article>
@code {private List<EmployeeBenefitDto>? _items;private string? _error;private bool _busy;private BenefitForm _form=new();protected override async Task OnInitializedAsync()=>await Load();private async Task Load(){try{_items=await Http.GetFromJsonAsync<List<EmployeeBenefitDto>>("api/v1/hcm/employee-benefits")??[];}catch(HttpRequestException){_error="Could not load benefits.";_items=[];}}private async Task Create(){if(!Guid.TryParse(_form.EmployeeId,out var id)){_error="Enter a valid employee ID.";return;}await Mutate(()=>Http.PostAsJsonAsync("api/v1/hcm/employee-benefits",new CreateEmployeeBenefitRequest(id,_form.Name,_form.Provider,_form.Start,_form.End)));}private async Task End(EmployeeBenefitDto x)=>await Mutate(()=>Http.PutAsJsonAsync($"api/v1/hcm/employee-benefits/{x.Id}",new UpdateEmployeeBenefitRequest(x.BenefitName,x.Provider,x.EnrollmentDate,DateOnly.FromDateTime(DateTime.Today),BenefitEnrollmentStatus.Ended)));private async Task Mutate(Func<Task<HttpResponseMessage>> action){_busy=true;_error=null;try{using var response=await action();if(!response.IsSuccessStatusCode){_error="The change was rejected.";return;}await Load();}catch(HttpRequestException){_error="Could not save the change.";}finally{_busy=false;}}private sealed class BenefitForm{public string EmployeeId{get;set;}="";public string? Name{get;set;}public string? Provider{get;set;}public DateOnly Start{get;set;}=DateOnly.FromDateTime(DateTime.Today);public DateOnly? End{get;set;}}}



