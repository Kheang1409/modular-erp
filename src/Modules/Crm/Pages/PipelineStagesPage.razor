@page "/crm/stages"
@attribute [Authorize(Policy = CrmPermissions.Configure)]
@inject IOpportunityService Opportunities
<PageTitle>Pipeline stages</PageTitle><article class="card contacts-card"><p class="eyebrow">CRM configuration</p><h1>Pipeline stages</h1><EditForm Model="Form" OnValidSubmit="Save" FormName="new-stage"><div class="form-grid"><label>Name <InputText @bind-Value="Form.Name"/></label><label>Sequence <InputNumber @bind-Value="Form.Sequence"/></label><label>Default probability <InputNumber @bind-Value="Form.Probability"/></label><label><InputCheckbox @bind-Value="Form.IsWon"/> Won stage</label><label><InputCheckbox @bind-Value="Form.IsLost"/> Lost stage</label></div><button type="submit">Add stage</button></EditForm>@if(_stages is not null){<table><thead><tr><th>Sequence</th><th>Name</th><th>Probability</th><th>Kind</th></tr></thead><tbody>@foreach(var stage in _stages){<tr><td>@stage.Sequence</td><td>@stage.Name</td><td>@stage.DefaultProbability%</td><td>@(stage.IsWon?"Won":stage.IsLost?"Lost":"Open")</td></tr>}</tbody></table>}</article>
@code{private StageForm Form{get;}=new();private IReadOnlyList<PipelineStageDto>? _stages;protected override async Task OnInitializedAsync()=>await Load();private async Task Save(){await Opportunities.SaveStageAsync(null,new(Form.Name,Form.Sequence,Form.Probability,Form.IsWon,Form.IsLost),CancellationToken.None);Form.Name=null;Form.Sequence++;await Load();}private async Task Load()=>_stages=await Opportunities.GetStagesAsync(true,CancellationToken.None);private sealed class StageForm{public string? Name{get;set;}public int Sequence{get;set;}public int Probability{get;set;}public bool IsWon{get;set;}public bool IsLost{get;set;}}}
