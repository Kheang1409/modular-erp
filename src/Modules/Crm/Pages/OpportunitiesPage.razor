@page "/crm/opportunities"
@attribute [Authorize(Policy = CrmPermissions.Read)]
@inject IOpportunityService Opportunities
<PageTitle>Opportunities</PageTitle><article class="card contacts-card"><p class="eyebrow">CRM</p><h1>Opportunities</h1><p><a class="button" href="/crm/opportunities/new">New opportunity</a> <a href="/crm/leads">Leads</a></p>
<form method="get"><label>Search <input name="search" value="@Search" /></label><label>State <select name="state"><option value="">All</option>@foreach(var value in Enum.GetValues<OpportunityState>()){<option value="@value" selected="@(SelectedState==value)">@value</option>}</select></label><button type="submit">Filter</button></form>
@if(_page is null){<p>Loading…</p>}else if(_page.Items.Count==0){<p>No opportunities match this view.</p>}else{<table><thead><tr><th>Opportunity</th><th>Stage</th><th>Contact</th><th>Revenue</th><th>State</th></tr></thead><tbody>@foreach(var item in _page.Items){<tr><td><a href="@($"/crm/opportunities/{item.Id}")">@item.Title</a></td><td>@item.StageName</td><td>@(item.ContactName??"—")</td><td>@item.ExpectedRevenue.ToString("N2")</td><td>@item.State</td></tr>}</tbody></table>}</article>
@code{[SupplyParameterFromQuery]public string? Search{get;set;}[SupplyParameterFromQuery(Name="state")]public string? StateQuery{get;set;}private OpportunityPage? _page;private OpportunityState? SelectedState=>Enum.TryParse<OpportunityState>(StateQuery,true,out var state)?state:null;protected override async Task OnParametersSetAsync()=>_page=await Opportunities.SearchAsync(new(Search,SelectedState),CancellationToken.None);}
