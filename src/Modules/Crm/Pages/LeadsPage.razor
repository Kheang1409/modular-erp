@page "/crm/leads"
@attribute [Authorize(Policy = CrmPermissions.Read)]
@inject ILeadService Leads
<PageTitle>CRM leads</PageTitle>
<article class="card contacts-card entity-page module-workspace">
    <div class="page-heading"><div><p class="eyebrow">Customer relationships</p><h1>Leads</h1><p class="muted">Prioritize new relationships and move qualified prospects into opportunities.</p></div><a class="button" href="/crm/leads/new">New lead</a></div>
    <nav class="register-tabs" aria-label="CRM workspace"><a class="is-current" href="/crm/leads" aria-current="page">Leads</a><a href="/crm/opportunities">Opportunities</a><a href="/crm/stages">Pipeline stages</a></nav>
    <form method="get" class="filter-bar"><label class="filter-search"><span>Search leads</span><input name="search" value="@Search" placeholder="Name or organization" /></label><label><span>State</span><select name="state"><option value="">All states</option>@foreach(var state in Enum.GetValues<LeadState>()){<option value="@state" selected="@(SelectedState == state)">@state</option>}</select></label><button type="submit">Apply filters</button></form>
    @if (_page is null) { <p class="loading-state" role="status">Loading leads…</p> } else if (_page.Items.Count == 0) { <div class="empty-state"><h2>No leads match this view</h2><p>Try a different search or create a lead.</p><a class="button" href="/crm/leads/new">Create lead</a></div> } else { <div class="list-meta"><strong>@_page.Total lead(s)</strong><span>Page @Math.Max(Page,1)</span></div><div class="table-scroll" tabindex="0"><table class="data-table"><thead><tr><th>Lead</th><th>Contact</th><th>State</th><th class="numeric">Revenue</th><th class="numeric">Probability</th></tr></thead><tbody>@foreach(var lead in _page.Items){<tr><td><a class="entity-link" href="@($"/crm/leads/{lead.Id}/details")"><strong>@lead.Title</strong><span>Open lead details</span></a></td><td>@(lead.ContactName ?? "—")</td><td><span class="status-badge">@lead.State</span></td><td class="numeric">@lead.ExpectedRevenue.ToString("N2")</td><td class="numeric">@lead.Probability%</td></tr>}</tbody></table></div> }
</article>
@code { [SupplyParameterFromQuery] public string? Search { get; set; } [SupplyParameterFromQuery(Name="state")] public string? StateQuery { get; set; } [SupplyParameterFromQuery] public int Page { get; set; } private LeadPage? _page; private LeadState? SelectedState => Enum.TryParse<LeadState>(StateQuery,true,out var state)?state:null; protected override async Task OnParametersSetAsync()=>_page=await Leads.SearchAsync(new(Search,SelectedState,Page:Math.Max(1,Page)),CancellationToken.None); }
