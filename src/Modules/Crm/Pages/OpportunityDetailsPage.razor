@page "/crm/opportunities/{Id:guid}"
@attribute [Authorize(Policy = CrmPermissions.Read)]
@inject IOpportunityService Opportunities
@inject IActivityService Activities
<PageTitle>Opportunity</PageTitle>
<article class="card contacts-card">@if (_item is null) { <p>Loading or not found...</p> } else { <p class="eyebrow">@_item.State · @_item.StageName</p><h1>@_item.Title</h1><dl><dt>Contact</dt><dd>@(_item.ContactName ?? "—")</dd><dt>Expected revenue</dt><dd>@_item.ExpectedRevenue.ToString("N2")</dd><dt>Probability</dt><dd>@_item.Probability%</dd><dt>Status</dt><dd>@(_item.IsArchived ? "Archived" : "Active")</dd></dl><p><a class="button" href="@($"/crm/opportunities/{Id}/edit")">Manage</a> <a href="@($"/crm/opportunities/{Id}/assignment")">Assign</a> <a href="@($"/crm/opportunities/{Id}/archive")">@(_item.IsArchived ? "Reactivate" : "Archive")</a> <a href="@($"/crm/activities/new?opportunityId={Id}")">Add activity</a> <a href="/crm/opportunities">Back</a></p><h2>Timeline</h2>@if (_activities?.Count == 0) { <p>No activities yet.</p> } else { <ul>@foreach (var activity in _activities ?? []) { <li><strong>@activity.Subject</strong> · @activity.Type · @(activity.CompletedAtUtc is null ? "Open" : "Completed") · <a href="@($"/crm/activities/{activity.Id}/manage?opportunityId={Id}")">Manage</a></li> }</ul> } }</article>
@code { [Parameter] public Guid Id { get; set; } private OpportunityDto? _item; private IReadOnlyList<ActivityDto>? _activities; protected override async Task OnParametersSetAsync() { _item = await Opportunities.GetAsync(Id, CancellationToken.None); _activities = await Activities.ListAsync(null, Id, CancellationToken.None); } }
