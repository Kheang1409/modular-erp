@page "/crm/leads/{Id:guid}/details"
@attribute [Authorize(Policy = CrmPermissions.Read)]
@inject ILeadService Leads
@inject IActivityService Activities
<PageTitle>Lead details</PageTitle>
<article class="card contacts-card">@if (_lead is null) { <p>Loading or not found...</p> } else { <p class="eyebrow">@_lead.State</p><h1>@_lead.Title</h1><dl><dt>Contact</dt><dd>@(_lead.ContactName ?? "—")</dd><dt>Email</dt><dd>@(_lead.Email ?? "—")</dd><dt>Source</dt><dd>@(_lead.Source ?? "—")</dd><dt>Expected revenue</dt><dd>@_lead.ExpectedRevenue.ToString("N2")</dd><dt>Probability</dt><dd>@_lead.Probability%</dd><dt>Status</dt><dd>@(_lead.IsArchived ? "Archived" : "Active")</dd></dl><p><a class="button" href="@($"/crm/leads/{Id}")">Edit</a> <a href="@($"/crm/leads/{Id}/assignment")">Assign</a> <a href="@($"/crm/leads/{Id}/archive")">@(_lead.IsArchived ? "Reactivate" : "Archive")</a> <a href="@($"/crm/activities/new?leadId={Id}")">Add activity</a> <a href="/crm/leads">Back</a></p><h2>Timeline</h2>@if (_activities?.Count == 0) { <p>No activities yet.</p> } else { <ul>@foreach (var activity in _activities ?? []) { <li><strong>@activity.Subject</strong> · @activity.Type · @(activity.CompletedAtUtc is null ? "Open" : "Completed") · <a href="@($"/crm/activities/{activity.Id}/manage?leadId={Id}")">Manage</a></li> }</ul> } }</article>
@code { [Parameter] public Guid Id { get; set; } private LeadDto? _lead; private IReadOnlyList<ActivityDto>? _activities; protected override async Task OnParametersSetAsync() { _lead = await Leads.GetAsync(Id, CancellationToken.None); _activities = await Activities.ListAsync(Id, null, CancellationToken.None); } }
