@page "/crm/opportunities/new"
@attribute [Authorize(Policy = CrmPermissions.Manage)]
@inject IOpportunityService Opportunities
@inject NavigationManager Navigation
<PageTitle>New opportunity</PageTitle><article class="card contacts-card"><p class="eyebrow">CRM</p><h1>New opportunity</h1>@if(_stages is null){<p>Loading…</p>}else if(_stages.Count==0){<p role="alert">Configure an active open pipeline stage first.</p>}else{<EditForm Model="Form" OnValidSubmit="Save" FormName="new-opportunity"><DataAnnotationsValidator/><ValidationSummary/><div class="form-grid"><label>Title <InputText @bind-Value="Form.Title"/></label><label>Stage <InputSelect @bind-Value="Form.StageId">@foreach(var stage in _stages){<option value="@stage.Id">@stage.Name (@stage.DefaultProbability%)</option>}</InputSelect></label><label>Expected revenue <InputNumber @bind-Value="Form.ExpectedRevenue"/></label><label class="wide">Notes <InputTextArea @bind-Value="Form.Notes"/></label></div><button type="submit" disabled="@_busy">Save opportunity</button>@if(_error is not null){<p role="alert">@_error</p>}</EditForm>}</article>
@code{private List<PipelineStageDto>? _stages;private OpportunityForm Form{get;}=new();private bool _busy;private string? _error;protected override async Task OnInitializedAsync(){_stages=(await Opportunities.GetStagesAsync(false,CancellationToken.None)).Where(x=>!x.IsWon&&!x.IsLost).ToList();if(_stages.Count>0)Form.StageId=_stages[0].Id;}private async Task Save(){_busy=true;try{var item=await Opportunities.CreateAsync(Form.ToRequest(),CancellationToken.None);Navigation.NavigateTo($"/crm/opportunities/{item.Id}");}catch(Exception ex){_error=ex.Message;}finally{_busy=false;}}}
