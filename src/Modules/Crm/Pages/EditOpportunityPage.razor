@page "/crm/opportunities/{Id:guid}/edit"
@attribute [Authorize(Policy = CrmPermissions.Manage)]
@inject IOpportunityService Opportunities
@inject NavigationManager Navigation
<PageTitle>Manage opportunity</PageTitle>
<article class="card contacts-card"><p class="eyebrow">CRM</p><h1>Manage opportunity</h1>@if (Form is null) { <p>Loading...</p> } else { <EditForm Model="Form" OnValidSubmit="Save" FormName="edit-opportunity"><DataAnnotationsValidator/><ValidationSummary/><div class="form-grid"><label>Title <InputText @bind-Value="Form.Title"/></label><label>Stage <InputSelect @bind-Value="Form.StageId">@foreach(var stage in _openStages){<option value="@stage.Id">@stage.Name</option>}</InputSelect></label><label>Expected revenue <InputNumber @bind-Value="Form.ExpectedRevenue"/></label><label class="wide">Notes <InputTextArea @bind-Value="Form.Notes"/></label></div><button type="submit">Save</button></EditForm><h2>Move stage</h2><EditForm Model="Move" OnValidSubmit="MoveStage" FormName="move-opportunity"><label>Stage <InputSelect @bind-Value="Move.StageId">@foreach(var stage in _allStages){<option value="@stage.Id">@stage.Name</option>}</InputSelect></label><label>Lost reason <InputText @bind-Value="Move.LostReason"/></label><button type="submit">Move</button></EditForm>@if (_error is not null) { <p role="alert">@_error</p> } }</article>
@code { [Parameter] public Guid Id { get; set; } private OpportunityForm? Form; private OpportunityDto? _item; private IReadOnlyList<PipelineStageDto> _allStages=[]; private IReadOnlyList<PipelineStageDto> _openStages=[]; private MoveForm Move{get;}=new(); private string? _error; protected override async Task OnParametersSetAsync(){_item=await Opportunities.GetAsync(Id,CancellationToken.None);_allStages=await Opportunities.GetStagesAsync(false,CancellationToken.None);_openStages=_allStages.Where(x=>!x.IsWon&&!x.IsLost).ToList();Form=_item is null?null:OpportunityForm.From(_item);Move.StageId=_item?.StageId??Guid.Empty;} private async Task Save(){try{_item=await Opportunities.UpdateAsync(Id,Form!.ToRequest(),CancellationToken.None);Navigation.NavigateTo($"/crm/opportunities/{_item.Id}");}catch(Exception ex){_error=ex.Message;}} private async Task MoveStage(){try{_item=await Opportunities.MoveAsync(Id,new(_item!.ConcurrencyStamp,Move.StageId,Move.LostReason),CancellationToken.None);Navigation.NavigateTo($"/crm/opportunities/{_item.Id}");}catch(Exception ex){_error=ex.Message;}} private sealed class MoveForm{public Guid StageId{get;set;}public string? LostReason{get;set;}} }
