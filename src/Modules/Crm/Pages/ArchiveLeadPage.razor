@page "/crm/leads/{Id:guid}/archive"
@attribute [Authorize(Policy = CrmPermissions.Archive)]
@inject ILeadService Leads
@inject NavigationManager Navigation
<PageTitle>Lead status</PageTitle><article class="card contacts-card"><h1>@(_item?.IsArchived == true ? "Reactivate lead" : "Archive lead")</h1>@if(_item is null){<p>Loading...</p>}else{<p>Confirm this status change for <strong>@_item.Title</strong>.</p><button @onclick="Apply">@(_item.IsArchived ? "Reactivate" : "Archive")</button>@if(_error is not null){<p role="alert">@_error</p>}}</article>
@code{[Parameter]public Guid Id{get;set;}private LeadDto? _item;private string? _error;protected override async Task OnParametersSetAsync()=>_item=await Leads.GetAsync(Id,CancellationToken.None);private async Task Apply(){try{await Leads.SetArchivedAsync(Id,_item!.ConcurrencyStamp,!_item.IsArchived,CancellationToken.None);Navigation.NavigateTo($"/crm/leads/{Id}/details");}catch(Exception ex){_error=ex.Message;}}}
