@page "/crm/activities/new"
@attribute [Authorize(Policy = CrmPermissions.Manage)]
@inject IActivityService Activities
@inject NavigationManager Navigation
<PageTitle>New activity</PageTitle>
<article class="card contacts-card"><p class="eyebrow">CRM timeline</p><h1>New activity</h1>@if (!LeadId.HasValue && !OpportunityId.HasValue) { <p role="alert">A lead or opportunity is required.</p> } else { <EditForm Model="Form" OnValidSubmit="Save" FormName="new-activity"><DataAnnotationsValidator/><ValidationSummary/><div class="form-grid"><label>Type <InputSelect @bind-Value="Form.Type">@foreach(var type in Enum.GetValues<ActivityType>()){<option value="@type">@type</option>}</InputSelect></label><label>Subject <InputText @bind-Value="Form.Subject"/></label><label class="wide">Details <InputTextArea @bind-Value="Form.Details"/></label></div><button type="submit">Add activity</button>@if(_error is not null){<p role="alert">@_error</p>}</EditForm> }</article>
@code { [SupplyParameterFromQuery] public Guid? LeadId { get; set; } [SupplyParameterFromQuery] public Guid? OpportunityId { get; set; } private ActivityForm Form { get; }=new(); private string? _error; private async Task Save(){try{await Activities.CreateAsync(new(LeadId,OpportunityId,Form.Type,Form.Subject,Form.Details,null,null),CancellationToken.None);Navigation.NavigateTo(LeadId.HasValue?$"/crm/leads/{LeadId}/details":$"/crm/opportunities/{OpportunityId}");}catch(Exception ex){_error=ex.Message;}} private sealed class ActivityForm{public ActivityType Type{get;set;} [System.ComponentModel.DataAnnotations.Required,System.ComponentModel.DataAnnotations.StringLength(200)] public string? Subject{get;set;} public string? Details{get;set;}} }
