@page "/reports/inventory"
@attribute [Authorize(Policy = ReportingPermissions.Inventory)]
@inject HttpClient Http
<PageTitle>Inventory reports</PageTitle><article class="card contacts-card report-page"><p class="eyebrow">Reporting</p><h1>Inventory reconciliation</h1><p class="report-back-link"><a href="/reports/dashboard">Company dashboard</a> <span aria-hidden="true">/</span> Detailed report</p><p>On-hand balances and completed movement history as of explicit business dates. Valuation remains unavailable until a costing policy is selected.</p><EditForm Model="_filter" OnValidSubmit="Load" FormName="inventory-report-filter"><div class="content-grid"><label>From <InputDate @bind-Value="_filter.From"/></label><label>To / as of <InputDate @bind-Value="_filter.To"/></label></div><button disabled="@_loading">Run report</button></EditForm>
@if (!_loading && _error is null) { <ReportVisualizations Kind="ReportVisualizationKind.Inventory" Inventory="_balances" /> }
@if(_loading){<p role="status">Loading report...</p>}else if(_error is not null){<div class="notice notice-error" role="alert">@_error</div>}else{<p><small>Generated @_generated.ToLocalTime().ToString("g")</small></p><AuthorizeView Policy="@ReportingPermissions.Export" Context="exportAuth"><p><a href="@OnHandCsv">Export on-hand CSV</a> · <a href="@MovementCsv">Stream movement CSV</a></p></AuthorizeView><h2>On hand</h2>@if(_balances.Count==0){<p>No stock as of this date.</p>}else{<div class="table-scroll" tabindex="0"><table><thead><tr><th>SKU</th><th>Location</th><th>On hand</th><th>Reserved</th><th>Available</th></tr></thead><tbody>@foreach(var x in _balances){<tr><td>@x.ProductSku</td><td>@x.LocationCode - @x.LocationName</td><td>@x.OnHand @x.UnitCode</td><td>@x.Reserved</td><td>@x.Available</td></tr>}</tbody></table></div>}<h2>Movement history</h2>@if(_moves.Count==0){<p>No completed movements in this period.</p>}else{<div class="table-scroll" tabindex="0"><table><thead><tr><th>Date</th><th>Number</th><th>Type</th><th>SKU</th><th>Quantity</th></tr></thead><tbody>@foreach(var x in _moves){<tr><td>@x.BusinessDate</td><td>@x.Number</td><td>@x.Type</td><td>@x.ProductSku</td><td>@x.Quantity @x.UnitCode</td></tr>}</tbody></table></div>}}</article>
@code{private Filter _filter=new();private List<InventoryOnHandReportRow> _balances=[];private List<InventoryMovementReportRow> _moves=[];private bool _loading=true;private string? _error;private DateTimeOffset _generated;private string OnHandCsv=>$"api/v1/reports/inventory/on-hand.csv?asOf={_filter.To:yyyy-MM-dd}";private string MovementCsv=>$"api/v1/reports/inventory/movements.csv?from={_filter.From:yyyy-MM-dd}&to={_filter.To:yyyy-MM-dd}";protected override Task OnInitializedAsync()=>Load();private async Task Load(){_loading=true;_error=null;try{var a=await Http.GetFromJsonAsync<ReportEnvelope<List<InventoryOnHandReportRow>>>($"api/v1/reports/inventory/on-hand?asOf={_filter.To:yyyy-MM-dd}");var b=await Http.GetFromJsonAsync<ReportEnvelope<InventoryMovementReportPage>>($"api/v1/reports/inventory/movements?from={_filter.From:yyyy-MM-dd}&to={_filter.To:yyyy-MM-dd}&page=1&pageSize=100");_balances=a?.Data??[];_moves=b?.Data.Items.ToList()??[];_generated=a?.GeneratedAtUtc??DateTimeOffset.UtcNow;}catch(HttpRequestException){_error="Inventory reports could not be loaded.";}finally{_loading=false;}}private sealed class Filter{public DateOnly From{get;set;}=new(DateTime.Today.Year,1,1);public DateOnly To{get;set;}=DateOnly.FromDateTime(DateTime.Today);}}
