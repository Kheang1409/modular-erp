@page "/reports/inventory"
@attribute [Authorize(Policy = ReportingPermissions.Inventory)]
@inject HttpClient Http

<PageTitle>Inventory reports</PageTitle>
<article class="card contacts-card report-page" aria-busy="@Busy.ToString().ToLowerInvariant()">
    <p class="eyebrow">Reporting</p>
    <h1>Inventory reconciliation</h1>
    <p class="report-back-link"><a href="/reports/dashboard">Company dashboard</a> <span aria-hidden="true">/</span> Detailed report</p>
    <p>On-hand balances and completed movement history as of explicit business dates. Valuation remains unavailable until a costing policy is selected.</p>
    <EditForm Model="_filter" OnValidSubmit="Load" FormName="inventory-report-filter">
        <div class="content-grid">
            <label>From <InputDate @bind-Value="_filter.From" /></label>
            <label>To / as of <InputDate @bind-Value="_filter.To" /></label>
        </div>
        <button disabled="@Busy">Run report</button>
    </EditForm>

    @if (_loading)
    {
        <p role="status">Loading report...</p>
    }
    else if (_error is not null)
    {
        <div class="notice notice-error" role="alert">@_error</div>
    }
    else
    {
        <ReportVisualizations Kind="ReportVisualizationKind.Inventory" Inventory="_balances" />
        <p><small>Generated @_generated.ToLocalTime().ToString("g")</small></p>
        <AuthorizeView Policy="@ReportingPermissions.Export" Context="exportAuth">
            <p><a href="@OnHandCsv">Export on-hand CSV</a> &middot; <a href="@MovementCsv">Stream movement CSV</a></p>
        </AuthorizeView>
        <h2>On hand</h2>
        @if (_balances.Count == 0)
        {
            <p>No stock as of this date.</p>
        }
        else
        {
            <div class="table-scroll" role="region" aria-label="On-hand inventory table" tabindex="0">
                <table>
                    <caption>On-hand inventory</caption>
                    <thead><tr><th scope="col">SKU</th><th scope="col">Location</th><th scope="col">On hand</th><th scope="col">Reserved</th><th scope="col">Available</th></tr></thead>
                    <tbody>
                        @foreach (var row in _balances)
                        {
                            <tr><td>@row.ProductSku</td><td>@row.LocationCode - @row.LocationName</td><td>@row.OnHand @row.UnitCode</td><td>@row.Reserved</td><td>@row.Available</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <h2>Movement history</h2>
        <p>Applied period: @_appliedFrom.ToString("yyyy-MM-dd") to @_appliedTo.ToString("yyyy-MM-dd").</p>
        @if (_paging)
        {
            <p role="status">Loading movement history page...</p>
        }
        @if (_pageError is not null)
        {
            <div class="notice notice-error" role="alert">@_pageError</div>
        }
        @if (_moves.Count == 0)
        {
            <p>No completed movements in this period.</p>
        }
        else
        {
            <div class="table-scroll" role="region" aria-label="Movement history table" tabindex="0">
                <table>
                    <caption>Completed inventory movements</caption>
                    <thead><tr><th scope="col">Date</th><th scope="col">Number</th><th scope="col">Type</th><th scope="col">SKU</th><th scope="col">Quantity</th></tr></thead>
                    <tbody>
                        @foreach (var row in _moves)
                        {
                            <tr><td>@row.BusinessDate</td><td>@row.Number</td><td>@row.Type</td><td>@row.ProductSku</td><td>@row.Quantity @row.UnitCode</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <ReportPagination State="_movementPages" Label="Movement history pagination" PageSizeLabel="Movement history rows per page" Busy="Busy" PageChanged="LoadMovementPage" PageSizeChanged="ChangeMovementPageSize" />
    }
</article>

@code {
    private readonly Filter _filter = new();
    private readonly ReportPaginationState _movementPages = new();
    private List<InventoryOnHandReportRow> _balances = [];
    private List<InventoryMovementReportRow> _moves = [];
    private bool _loading, _paging;
    private string? _error, _pageError;
    private DateTimeOffset _generated;
    private DateOnly _appliedFrom, _appliedTo;
    private bool Busy => _loading || _paging;
    private string OnHandCsv => $"api/v1/reports/inventory/on-hand.csv?asOf={_appliedTo:yyyy-MM-dd}";
    private string MovementCsv => $"api/v1/reports/inventory/movements.csv?from={_appliedFrom:yyyy-MM-dd}&to={_appliedTo:yyyy-MM-dd}";

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        if (Busy) return;
        _loading = true;
        _error = null;
        _pageError = null;
        var from = _filter.From;
        var to = _filter.To;
        try
        {
            if (from > to)
            {
                _error = "From date must be on or before To date.";
                return;
            }
            // Report modules share a scoped connection; keep these reads sequential.
            var balances = await Http.GetFromJsonAsync<ReportEnvelope<List<InventoryOnHandReportRow>>>($"api/v1/reports/inventory/on-hand?asOf={to:yyyy-MM-dd}");
            var movements = await GetMovementPage(from, to, 1, _movementPages.PageSize);
            _balances = balances?.Data ?? [];
            SetMovementPage(movements);
            _appliedFrom = from;
            _appliedTo = to;
            _generated = balances?.GeneratedAtUtc ?? DateTimeOffset.UtcNow;
        }
        catch (HttpRequestException)
        {
            _error = "Inventory reports could not be loaded.";
        }
        finally
        {
            _loading = false;
        }
    }

    private Task LoadMovementPage(int page) => LoadMovementPage(page, _movementPages.PageSize);
    private Task ChangeMovementPageSize(int pageSize) => LoadMovementPage(1, pageSize);

    private async Task LoadMovementPage(int page, int pageSize)
    {
        if (Busy || page < 1 || page > _movementPages.PageCount || !ReportPaginationState.IsSupportedSize(pageSize)) return;
        _paging = true;
        _pageError = null;
        try
        {
            var movements = await GetMovementPage(_appliedFrom, _appliedTo, page, pageSize);
            // Completed records can change while paging. Never leave an out-of-range page stranded.
            if (page > ReportPaginationState.LastPage(movements?.Total ?? 0, pageSize))
                movements = await GetMovementPage(_appliedFrom, _appliedTo, 1, pageSize);
            SetMovementPage(movements);
        }
        catch (HttpRequestException)
        {
            _pageError = "The movement history page could not be loaded. The previous page is still shown.";
        }
        finally
        {
            _paging = false;
        }
    }

    private async Task<InventoryMovementReportPage?> GetMovementPage(DateOnly from, DateOnly to, int page, int pageSize) =>
        (await Http.GetFromJsonAsync<ReportEnvelope<InventoryMovementReportPage>>($"api/v1/reports/inventory/movements?from={from:yyyy-MM-dd}&to={to:yyyy-MM-dd}&page={page}&pageSize={pageSize}"))?.Data;

    private void SetMovementPage(InventoryMovementReportPage? movements)
    {
        _moves = movements?.Items.ToList() ?? [];
        _movementPages.SetPage(movements?.Page ?? 1, movements?.Total ?? 0, _moves.Count, movements?.PageSize ?? _movementPages.PageSize);
    }

    private sealed class Filter
    {
        public DateOnly From { get; set; } = new(DateTime.Today.Year, 1, 1);
        public DateOnly To { get; set; } = DateOnly.FromDateTime(DateTime.Today);
    }
}
