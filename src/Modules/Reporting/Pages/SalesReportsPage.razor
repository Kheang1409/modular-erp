@page "/reports/sales"
@attribute [Authorize(Policy = ReportingPermissions.Sales)]
@inject HttpClient Http
<PageTitle>Sales reports</PageTitle><article class="card contacts-card report-page"><p class="eyebrow">Reporting</p><h1>Sales analysis</h1><p class="report-back-link"><a href="/reports/dashboard">Company dashboard</a> <span aria-hidden="true">/</span> Detailed report</p><p>Confirmed sales grouped by currency, customer, and product.</p><EditForm Model="_filter" OnValidSubmit="Load" FormName="sales-report-filter"><div class="content-grid"><label>From <InputDate @bind-Value="_filter.From"/></label><label>To <InputDate @bind-Value="_filter.To"/></label></div><button disabled="@_loading">Run report</button></EditForm>
@if (!_loading && _error is null) { <ReportVisualizations Kind="ReportVisualizationKind.Sales" Sales="_summary" Customers="_customers" Products="_products" /> }
@if(_loading){<p role="status">Loading report...</p>}else if(_error is not null){<div class="notice notice-error" role="alert">@_error</div>}else{<p><small>Generated @_generated.ToLocalTime().ToString("g")</small></p><AuthorizeView Policy="@ReportingPermissions.Export" Context="exportAuth"><p><a href="@Csv("summary")">Export summary CSV</a> · <a href="@Csv("by-customer")">Export customer CSV</a> · <a href="@Csv("by-product")">Export product CSV</a></p></AuthorizeView><h2>Summary</h2><div class="table-scroll" tabindex="0"><table><thead><tr><th>Currency</th><th>Orders</th><th>Subtotal</th><th>Discount</th><th>Tax</th><th>Total</th></tr></thead><tbody>@foreach(var x in _summary){<tr><td>@x.CurrencyCode</td><td>@x.OrderCount</td><td>@x.Subtotal.ToString("N2")</td><td>@x.Discount.ToString("N2")</td><td>@x.Tax.ToString("N2")</td><td>@x.Total.ToString("N2")</td></tr>}</tbody></table></div><h2>By customer</h2><div class="table-scroll" tabindex="0"><table><thead><tr><th>Customer</th><th>Currency</th><th>Orders</th><th>Total</th></tr></thead><tbody>@foreach(var x in _customers){<tr><td>@x.CustomerName</td><td>@x.CurrencyCode</td><td>@x.OrderCount</td><td>@x.Total.ToString("N2")</td></tr>}</tbody></table></div><h2>By product</h2><div class="table-scroll" tabindex="0"><table><thead><tr><th>SKU</th><th>Description</th><th>Currency</th><th>Quantity</th><th>Total</th></tr></thead><tbody>@foreach(var x in _products){<tr><td>@x.ProductSku</td><td>@x.Description</td><td>@x.CurrencyCode</td><td>@x.Quantity</td><td>@x.Total.ToString("N2")</td></tr>}</tbody></table></div>}</article>
@code{private Filter _filter=new();private List<SalesSummaryReportRow> _summary=[];private List<SalesByCustomerReportRow> _customers=[];private List<SalesByProductReportRow> _products=[];private bool _loading=true;private string? _error;private DateTimeOffset _generated;protected override Task OnInitializedAsync()=>Load();private async Task Load(){_loading=true;_error=null;try{var range=$"from={_filter.From:yyyy-MM-dd}&to={_filter.To:yyyy-MM-dd}";var a=await Http.GetFromJsonAsync<ReportEnvelope<List<SalesSummaryReportRow>>>($"api/v1/reports/sales/summary?{range}");var b=await Http.GetFromJsonAsync<ReportEnvelope<List<SalesByCustomerReportRow>>>($"api/v1/reports/sales/by-customer?{range}");var c=await Http.GetFromJsonAsync<ReportEnvelope<List<SalesByProductReportRow>>>($"api/v1/reports/sales/by-product?{range}");_summary=a?.Data??[];_customers=b?.Data??[];_products=c?.Data??[];_generated=a?.GeneratedAtUtc??DateTimeOffset.UtcNow;}catch(HttpRequestException){_error="Sales reports could not be loaded.";}finally{_loading=false;}}private string Csv(string name)=>$"api/v1/reports/sales/{name}.csv?from={_filter.From:yyyy-MM-dd}&to={_filter.To:yyyy-MM-dd}";private sealed class Filter{public DateOnly From{get;set;}=new(DateTime.Today.Year,1,1);public DateOnly To{get;set;}=DateOnly.FromDateTime(DateTime.Today);}}
