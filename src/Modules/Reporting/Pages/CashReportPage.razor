@page "/reports/cash"
@attribute [Authorize(Policy = ReportingPermissions.Cash)]
@inject HttpClient Http
<PageTitle>Cash summary</PageTitle><article class="card contacts-card report-page"><p class="eyebrow">Reporting</p><h1>Cash and payment summary</h1><p class="report-back-link"><a href="/reports/dashboard">Company dashboard</a> <span aria-hidden="true">/</span> Detailed report</p><EditForm Model="_filter" OnValidSubmit="Load" FormName="cash-report-filter"><div class="content-grid"><label>From <InputDate @bind-Value="_filter.From"/></label><label>To <InputDate @bind-Value="_filter.To"/></label></div><button disabled="@_loading">Run report</button></EditForm>
@if (!_loading && _error is null) { <ReportVisualizations Kind="ReportVisualizationKind.Cash" Cash="_rows" /> }
@if(_loading){<p role="status">Loading cash summary...</p>}else if(_error is not null){<div class="notice notice-error" role="alert">@_error</div>}else{<p><small>Generated @_generated.ToLocalTime().ToString("g")</small></p><AuthorizeView Policy="@ReportingPermissions.Export" Context="exportAuth"><p><a href="@Csv">Export CSV</a></p></AuthorizeView>@if(_rows.Count==0){<p>No posted payments in this period.</p>}else{<div class="table-scroll" tabindex="0"><table><thead><tr><th>Direction</th><th>Currency</th><th>Count</th><th>Amount</th></tr></thead><tbody>@foreach(var x in _rows){<tr><td>@x.Direction</td><td>@x.CurrencyCode</td><td>@x.Count</td><td>@x.Amount.ToString("N2")</td></tr>}</tbody></table></div>}}</article>
@code{private Filter _filter=new();private List<CashSummaryRow> _rows=[];private bool _loading=true;private string? _error;private DateTimeOffset _generated;private string Csv=>$"api/v1/reports/cash/summary.csv?from={_filter.From:yyyy-MM-dd}&to={_filter.To:yyyy-MM-dd}";protected override Task OnInitializedAsync()=>Load();private async Task Load(){_loading=true;_error=null;try{var x=await Http.GetFromJsonAsync<ReportEnvelope<List<CashSummaryRow>>>($"api/v1/reports/cash/summary?from={_filter.From:yyyy-MM-dd}&to={_filter.To:yyyy-MM-dd}");_rows=x?.Data??[];_generated=x?.GeneratedAtUtc??DateTimeOffset.UtcNow;}catch(HttpRequestException){_error="Cash summary could not be loaded.";}finally{_loading=false;}}private sealed class Filter{public DateOnly From{get;set;}=new(DateTime.Today.Year,1,1);public DateOnly To{get;set;}=DateOnly.FromDateTime(DateTime.Today);}}
