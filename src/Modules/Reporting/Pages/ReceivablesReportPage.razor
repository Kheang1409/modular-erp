@page "/reports/receivables"
@attribute [Authorize(Policy = ReportingPermissions.Receivables)]
@inject HttpClient Http

<PageTitle>Receivables aging</PageTitle>
<article class="card contacts-card report-page" aria-busy="@_loading.ToString().ToLowerInvariant()">
    <p class="eyebrow">Reporting</p>
    <h1>Accounts receivable aging</h1>
    <p class="report-back-link"><a href="/reports/dashboard">Company dashboard</a> <span aria-hidden="true">/</span> Detailed report</p>
    <label>As of <InputDate @bind-Value="_asOf" /></label>
    <button disabled="@_loading" @onclick="Load">Run report</button>

    @if (_loading)
    {
        <p role="status">Loading aging...</p>
    }
    else if (_error is not null)
    {
        <div class="notice notice-error" role="alert">@_error</div>
    }
    else
    {
        <ReportVisualizations Kind="ReportVisualizationKind.Receivables" Aging="_rows" />
        <p><small>As of @_appliedAsOf.ToString("yyyy-MM-dd") &middot; Generated @_generated.ToLocalTime().ToString("g")</small></p>
        <AuthorizeView Policy="@ReportingPermissions.Export" Context="exportAuth">
            <p><a href="@Csv">Export CSV</a></p>
        </AuthorizeView>
        @if (_rows.Count == 0)
        {
            <p>No open receivables.</p>
        }
        else
        {
            <div class="table-scroll" role="region" aria-label="Receivables aging table" tabindex="0">
                <table>
                    <caption>Receivables aging</caption>
                    <thead><tr><th scope="col">Customer</th><th scope="col">Currency</th><th scope="col">Current</th><th scope="col">1-30</th><th scope="col">31-60</th><th scope="col">61-90</th><th scope="col">90+</th><th scope="col">Total</th></tr></thead>
                    <tbody>
                        @foreach (var row in _rows)
                        {
                            <tr><td>@row.PartyName</td><td>@row.CurrencyCode</td><td>@row.Current.ToString("N2")</td><td>@row.Days1To30.ToString("N2")</td><td>@row.Days31To60.ToString("N2")</td><td>@row.Days61To90.ToString("N2")</td><td>@row.Over90.ToString("N2")</td><td>@row.Total.ToString("N2")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</article>

@code {
    private DateOnly _asOf = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly _appliedAsOf;
    private List<AgingReportRow> _rows = [];
    private bool _loading;
    private string? _error;
    private DateTimeOffset _generated;
    private string Csv => $"api/v1/reports/aging/receivables.csv?asOf={_appliedAsOf:yyyy-MM-dd}";

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        if (_loading) return;
        _loading = true;
        _error = null;
        var asOf = _asOf;
        try
        {
            var report = await Http.GetFromJsonAsync<ReportEnvelope<List<AgingReportRow>>>($"api/v1/reports/aging/receivables?asOf={asOf:yyyy-MM-dd}");
            _rows = report?.Data ?? [];
            _appliedAsOf = asOf;
            _generated = report?.GeneratedAtUtc ?? DateTimeOffset.UtcNow;
        }
        catch (HttpRequestException)
        {
            _error = "Receivables aging could not be loaded.";
        }
        finally
        {
            _loading = false;
        }
    }
}
