@page "/reports/payables"
@attribute [Authorize(Policy = ReportingPermissions.Payables)]
@inject HttpClient Http
<PageTitle>Payables aging</PageTitle><article class="card contacts-card report-page"><p class="eyebrow">Reporting</p><h1>Accounts payable aging</h1><p class="report-back-link"><a href="/reports/dashboard">Company dashboard</a> <span aria-hidden="true">/</span> Detailed report</p><label>As of <InputDate @bind-Value="_asOf"/></label><button disabled="@_loading" @onclick="Load">Run report</button>
@if (!_loading && _error is null) { <ReportVisualizations Kind="ReportVisualizationKind.Payables" Aging="_rows" /> }
@if(_loading){<p role="status">Loading aging...</p>}else if(_error is not null){<div class="notice notice-error" role="alert">@_error</div>}else{<p><small>Generated @_generated.ToLocalTime().ToString("g")</small></p><AuthorizeView Policy="@ReportingPermissions.Export" Context="exportAuth"><p><a href="@Csv">Export CSV</a></p></AuthorizeView>@if(_rows.Count==0){<p>No open payables.</p>}else{<div class="table-scroll" tabindex="0"><table><thead><tr><th>Supplier</th><th>Currency</th><th>Current</th><th>1-30</th><th>31-60</th><th>61-90</th><th>90+</th><th>Total</th></tr></thead><tbody>@foreach(var x in _rows){<tr><td>@x.PartyName</td><td>@x.CurrencyCode</td><td>@x.Current.ToString("N2")</td><td>@x.Days1To30.ToString("N2")</td><td>@x.Days31To60.ToString("N2")</td><td>@x.Days61To90.ToString("N2")</td><td>@x.Over90.ToString("N2")</td><td>@x.Total.ToString("N2")</td></tr>}</tbody></table></div>}}</article>
@code{private DateOnly _asOf=DateOnly.FromDateTime(DateTime.Today);private List<AgingReportRow> _rows=[];private bool _loading=true;private string? _error;private DateTimeOffset _generated;private string Csv=>$"api/v1/reports/aging/payables.csv?asOf={_asOf:yyyy-MM-dd}";protected override Task OnInitializedAsync()=>Load();private async Task Load(){_loading=true;_error=null;try{var x=await Http.GetFromJsonAsync<ReportEnvelope<List<AgingReportRow>>>($"api/v1/reports/aging/payables?asOf={_asOf:yyyy-MM-dd}");_rows=x?.Data??[];_generated=x?.GeneratedAtUtc??DateTimeOffset.UtcNow;}catch(HttpRequestException){_error="Payables aging could not be loaded.";}finally{_loading=false;}}}
