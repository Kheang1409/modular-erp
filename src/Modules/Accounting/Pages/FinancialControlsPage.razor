@page "/accounting/controls"
@attribute [Authorize(Policy = AccountingPermissions.Read)]
@inject HttpClient Http
<PageTitle>Financial controls</PageTitle>
<article class="card contacts-card"><p class="eyebrow">Accounting</p><h1>Tax and currency controls</h1><p>Maintain reusable tax definitions and dated exchange rates. Posted documents retain their original rate snapshots.</p>
@if(_loading){<p role="status">Loading financial controls...</p>}else if(_error is not null){<div class="notice notice-error" role="alert">@_error <button @onclick="Load">Try again</button></div>}else{
<AuthorizeView Policy="@AccountingPermissions.Configure" Context="controlsAuth"><div class="content-grid"><section><h2>New tax code</h2><EditForm Model="_tax" OnValidSubmit="SaveTax" FormName="tax-code" Context="taxForm"><DataAnnotationsValidator/><ValidationSummary/><label>Code <InputText @bind-Value="_tax.Code"/></label><label>Name <InputText @bind-Value="_tax.Name"/></label><label>Rate % <InputNumber @bind-Value="_tax.Rate"/></label><label>Output tax account <InputSelect @bind-Value="_tax.OutputAccountId"><option value="">None</option>@foreach(var a in _accounts){<option @key="a.Id" value="@a.Id">@a.Code - @a.Name</option>}</InputSelect></label><label>Input tax account <InputSelect @bind-Value="_tax.InputAccountId"><option value="">None</option>@foreach(var a in _accounts){<option @key="a.Id" value="@a.Id">@a.Code - @a.Name</option>}</InputSelect></label><button disabled="@_saving">Add tax code</button></EditForm></section><section><h2>New exchange rate</h2><EditForm Model="_rate" OnValidSubmit="SaveRate" FormName="currency-rate" Context="rateForm"><DataAnnotationsValidator/><ValidationSummary/><label>Base currency <InputText @bind-Value="_rate.Base" maxlength="3"/></label><label>Quote currency <InputText @bind-Value="_rate.Quote" maxlength="3"/></label><label>Effective date <InputDate @bind-Value="_rate.Date"/></label><label>Rate <InputNumber @bind-Value="_rate.Rate"/></label><button disabled="@_saving">Add exchange rate</button></EditForm></section></div></AuthorizeView>
@if(_message is not null){<div class="notice notice-success" role="status">@_message</div>}<h2>Tax codes</h2>@if(_taxes.Count==0){<p>No tax codes configured.</p>}else{<div class="table-scroll" tabindex="0" role="region" aria-label="Tax codes"><table><caption>Tax codes</caption><thead><tr><th scope="col">Code</th><th scope="col">Name</th><th scope="col">Rate</th><th scope="col">Status</th></tr></thead><tbody>@foreach(var x in _taxes){<tr><td>@x.Code</td><td>@x.Name</td><td>@x.Rate.ToString("N2")%</td><td>@(x.IsActive?"Active":"Inactive")</td></tr>}</tbody></table></div>}<h2>Exchange-rate history</h2>@if(_rates.Count==0){<p>No exchange rates configured.</p>}else{<div class="table-scroll" tabindex="0" role="region" aria-label="Exchange-rate history"><table><caption>Exchange-rate history</caption><thead><tr><th scope="col">Pair</th><th scope="col">Effective date</th><th scope="col">Rate</th></tr></thead><tbody>@foreach(var x in _rates){<tr><td>@x.BaseCurrencyCode / @x.QuoteCurrencyCode</td><td>@x.EffectiveDate</td><td>@x.Rate</td></tr>}</tbody></table></div>}}
</article>
@code{private readonly List<TaxCodeDto> _taxes=[];private readonly List<CurrencyRateDto> _rates=[];private readonly List<AccountDto> _accounts=[];private TaxForm _tax=new();private RateForm _rate=new();private bool _loading=true,_saving;private string? _error,_message;protected override Task OnInitializedAsync()=>Load();private async Task Load(){_loading=true;_error=null;try{_taxes.Clear();_taxes.AddRange(await Http.GetFromJsonAsync<List<TaxCodeDto>>("api/v1/accounting/tax-codes")??[]);_rates.Clear();_rates.AddRange(await Http.GetFromJsonAsync<List<CurrencyRateDto>>("api/v1/accounting/currency-rates")??[]);_accounts.Clear();_accounts.AddRange(await Http.GetFromJsonAsync<List<AccountDto>>("api/v1/accounting/accounts")??[]);}catch(HttpRequestException){_error="Financial controls could not be loaded.";}finally{_loading=false;}}private Task SaveTax()=>Send(()=>Http.PostAsJsonAsync("api/v1/accounting/tax-codes",new TaxCodeRequest(_tax.Code,_tax.Name,_tax.Rate,Parse(_tax.OutputAccountId),Parse(_tax.InputAccountId))),"Tax code added.");private Task SaveRate()=>Send(()=>Http.PostAsJsonAsync("api/v1/accounting/currency-rates",new CurrencyRateRequest(_rate.Base,_rate.Quote,_rate.Date,_rate.Rate)),"Exchange rate added.");private async Task Send(Func<Task<HttpResponseMessage>> action,string message){_saving=true;_error=null;try{var response=await action();if(response.IsSuccessStatusCode){_message=message;await Load();}else _error=await response.Content.ReadAsStringAsync();}catch(HttpRequestException){_error="The server could not be reached.";}finally{_saving=false;}}private static Guid? Parse(string? x)=>Guid.TryParse(x,out var id)?id:null;private sealed class TaxForm{[System.ComponentModel.DataAnnotations.Required]public string Code{get;set;}="";[System.ComponentModel.DataAnnotations.Required]public string Name{get;set;}="";public decimal Rate{get;set;}public string? OutputAccountId{get;set;}public string? InputAccountId{get;set;}}private sealed class RateForm{[System.ComponentModel.DataAnnotations.Required]public string Base{get;set;}="USD";[System.ComponentModel.DataAnnotations.Required]public string Quote{get;set;}="EUR";public DateOnly Date{get;set;}=DateOnly.FromDateTime(DateTime.Today);public decimal Rate{get;set;}=1;}}
