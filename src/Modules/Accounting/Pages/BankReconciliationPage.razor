@page "/accounting/reconciliation"
@attribute [Authorize(Policy = AccountingPermissions.Reconcile)]
@inject HttpClient Http
<PageTitle>Bank reconciliation</PageTitle>
<article class="card contacts-card"><p class="eyebrow">Accounting control</p><h1>Bank reconciliation</h1><p>Match posted journal entries to a statement. Finalization is allowed only when the calculated difference is zero.</p>
@if(_loading){<p role="status">Loading reconciliations...</p>}else if(_error is not null){<div class="notice notice-error" role="alert">@_error <button @onclick="Load">Try again</button></div>}else{
<section><h2>New reconciliation</h2><EditForm Model="_form" OnValidSubmit="Create" FormName="bank-reconciliation"><DataAnnotationsValidator/><ValidationSummary/><div class="content-grid"><label>Bank account <InputSelect @bind-Value="_form.BankAccountId">@foreach(var a in _accounts.Where(x=>x.Type==AccountType.Asset&&x.IsActive)){<option value="@a.Id">@a.Code - @a.Name</option>}</InputSelect></label><label>Statement date <InputDate @bind-Value="_form.StatementDate"/></label><label>Opening balance <InputNumber @bind-Value="_form.Opening"/></label><label>Closing balance <InputNumber @bind-Value="_form.Closing"/></label><label>Journal entry IDs <InputTextArea @bind-Value="_form.EntryIds"/><small>Comma-separated posted entry IDs.</small></label></div><button disabled="@_saving">Create reconciliation</button></EditForm></section>
@if(_message is not null){<div class="notice notice-success" role="status">@_message</div>}<h2>Reconciliation history</h2>@if(_items.Count==0){<p>No reconciliations yet.</p>}else{<div class="table-scroll" tabindex="0"><table><thead><tr><th>Number</th><th>Statement date</th><th>Cleared change</th><th>Difference</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach(var x in _items){<tr><td>@x.Number</td><td>@x.StatementDate</td><td>@x.ClearedChange.ToString("N2")</td><td>@x.Difference.ToString("N2")</td><td>@x.State</td><td>@if(x.State==BankReconciliationState.Draft){<button disabled="@(_saving||x.Difference!=0)" @onclick="()=>Finalize(x)">Finalize</button>}</td></tr>}</tbody></table></div>}}
</article>
@code{private readonly List<BankReconciliationDto> _items=[];private readonly List<AccountDto> _accounts=[];private Form _form=new();private bool _loading=true,_saving;private string? _error,_message;protected override Task OnInitializedAsync()=>Load();private async Task Load(){_loading=true;_error=null;try{_items.Clear();_items.AddRange(await Http.GetFromJsonAsync<List<BankReconciliationDto>>("api/v1/accounting/reconciliations")??[]);_accounts.Clear();_accounts.AddRange(await Http.GetFromJsonAsync<List<AccountDto>>("api/v1/accounting/accounts")??[]);if(_form.BankAccountId==Guid.Empty)_form.BankAccountId=_accounts.FirstOrDefault(x=>x.Type==AccountType.Asset&&x.IsActive)?.Id??Guid.Empty;}catch(HttpRequestException){_error="Reconciliations could not be loaded.";}finally{_loading=false;}}private async Task Create(){var ids=new List<Guid>();foreach(var value in _form.EntryIds.Split(',',StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries)){if(!Guid.TryParse(value,out var id)){_error="Every journal entry ID must be valid.";return;}ids.Add(id);}await Send(()=>Http.PostAsJsonAsync("api/v1/accounting/reconciliations",new CreateBankReconciliationRequest(_form.BankAccountId,_form.StatementDate,_form.Opening,_form.Closing,ids)),"Reconciliation created.");}private Task Finalize(BankReconciliationDto x)=>Send(()=>Http.PostAsJsonAsync($"api/v1/accounting/reconciliations/{x.Id}/finalize",new AccountingActionRequest(x.ConcurrencyStamp)),$"{x.Number} finalized.");private async Task Send(Func<Task<HttpResponseMessage>> action,string message){_saving=true;_error=null;try{var response=await action();if(response.IsSuccessStatusCode){_message=message;await Load();}else _error=await response.Content.ReadAsStringAsync();}catch(HttpRequestException){_error="The server could not be reached.";}finally{_saving=false;}}private sealed class Form{public Guid BankAccountId{get;set;}public DateOnly StatementDate{get;set;}=DateOnly.FromDateTime(DateTime.Today);public decimal Opening{get;set;}public decimal Closing{get;set;}public string EntryIds{get;set;}="";}}
