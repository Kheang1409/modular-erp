@page "/accounting/bills"
@attribute [Authorize(Policy = AccountingPermissions.BillRead)]
@inject HttpClient Http

<PageTitle>Supplier bills</PageTitle>
<article class="card contacts-card">
    <p class="eyebrow">Accounts payable</p><h1>Supplier bills</h1><p>Create a controlled bill snapshot from a confirmed or received purchase order, then post it to payables.</p>
    @if(_loading){<p role="status">Loading supplier bills...</p>}else if(_error is not null){<div class="notice notice-error" role="alert">@_error <button type="button" @onclick="Load">Try again</button></div>}else{
        <AuthorizeView Policy="@AccountingPermissions.BillManage" Context="billAuth"><section><h2>Bill a purchase order</h2><EditForm Model="_create" OnValidSubmit="Create" FormName="supplier-bill" Context="billForm"><DataAnnotationsValidator/><ValidationSummary/><div class="content-grid"><label>Purchase order ID <InputText @bind-Value="_create.PurchaseOrderId"/></label><label>Supplier invoice reference <InputText @bind-Value="_create.SupplierReference"/></label><label>Bill date <InputDate @bind-Value="_create.BillDate"/></label><label>Due date <InputDate @bind-Value="_create.DueDate"/></label></div><button disabled="@_saving">Create draft</button></EditForm></section></AuthorizeView>
        @if(_message is not null){<div class="notice notice-success" role="status">@_message</div>}
        <h2>Payables</h2>@if(_bills.Count==0){<p>No supplier bills yet.</p>}else{<div class="table-scroll" tabindex="0"><table><thead><tr><th>Bill</th><th>Supplier</th><th>Due</th><th>Total</th><th>Outstanding</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var bill in _bills){<tr><td>@bill.Number<br/><small>@bill.SupplierReference</small></td><td>@bill.SupplierName</td><td>@bill.DueDate</td><td>@bill.Total.ToString("N2") @bill.CurrencyCode</td><td>@bill.AmountDue.ToString("N2") @bill.CurrencyCode</td><td>@bill.State</td><td>@if(bill.State==SupplierBillState.Draft){<AuthorizeView Policy="@AccountingPermissions.BillPost" Context="postAuth"><button disabled="@_saving" @onclick="()=>Post(bill)">Post</button></AuthorizeView><AuthorizeView Policy="@AccountingPermissions.BillManage" Context="cancelAuth"><button class="button-secondary" disabled="@_saving" @onclick="()=>Cancel(bill)">Cancel</button></AuthorizeView>}</td></tr>}</tbody></table></div>}}
</article>
@code {
    private readonly List<SupplierBillDto> _bills=[];private readonly List<JournalDto> _journals=[];private readonly List<AccountDto> _accounts=[];private CreateForm _create=new();private bool _loading=true,_saving;private string? _error,_message;
    protected override Task OnInitializedAsync()=>Load();
    private async Task Load(){_loading=true;_error=null;try{_bills.Clear();_bills.AddRange(await Http.GetFromJsonAsync<List<SupplierBillDto>>("api/v1/accounting/bills")??[]);_journals.Clear();_journals.AddRange(await Http.GetFromJsonAsync<List<JournalDto>>("api/v1/accounting/journals")??[]);_accounts.Clear();_accounts.AddRange(await Http.GetFromJsonAsync<List<AccountDto>>("api/v1/accounting/accounts")??[]);}catch(HttpRequestException){_error="Supplier bills could not be loaded.";}finally{_loading=false;}}
    private async Task Create(){if(!Guid.TryParse(_create.PurchaseOrderId,out var orderId)){_error="Enter a valid purchase order ID.";return;}await Send(()=>Http.PostAsJsonAsync("api/v1/accounting/bills/from-purchase-order",new CreateSupplierBillRequest(orderId,_create.SupplierReference,_create.BillDate,_create.DueDate,Guid.NewGuid().ToString("N"))),"Supplier bill draft created.");}
    private async Task Post(SupplierBillDto bill){var journal=_journals.FirstOrDefault(x=>x.IsActive);var payable=_accounts.FirstOrDefault(x=>x.IsActive&&x.AllowDirectPosting&&x.Type==AccountType.Liability);var expense=_accounts.FirstOrDefault(x=>x.IsActive&&x.AllowDirectPosting&&x.Type==AccountType.Expense);var tax=_accounts.FirstOrDefault(x=>x.IsActive&&x.AllowDirectPosting&&x.Type==AccountType.Asset);if(journal is null||payable is null||expense is null||(bill.TaxTotal>0&&tax is null)){_error="Configure an active journal plus direct-posting payable, expense, and recoverable-tax accounts.";return;}await Send(()=>Http.PostAsJsonAsync($"api/v1/accounting/bills/{bill.Id}/post",new PostSupplierBillRequest(journal.Id,payable.Id,expense.Id,tax?.Id,bill.ConcurrencyStamp,Guid.NewGuid().ToString("N"))),$"{bill.Number} posted.");}
    private Task Cancel(SupplierBillDto bill)=>Send(()=>Http.PostAsJsonAsync($"api/v1/accounting/bills/{bill.Id}/cancel",new AccountingActionRequest(bill.ConcurrencyStamp)),$"{bill.Number} cancelled.");
    private async Task Send(Func<Task<HttpResponseMessage>> action,string message){_saving=true;_error=null;_message=null;try{var response=await action();if(response.IsSuccessStatusCode){_message=message;await Load();}else _error=await response.Content.ReadAsStringAsync();}catch(HttpRequestException){_error="The server could not be reached.";}finally{_saving=false;}}
    private sealed class CreateForm{[System.ComponentModel.DataAnnotations.Required]public string PurchaseOrderId{get;set;}="";[System.ComponentModel.DataAnnotations.Required]public string SupplierReference{get;set;}="";public DateOnly BillDate{get;set;}=DateOnly.FromDateTime(DateTime.Today);public DateOnly DueDate{get;set;}=DateOnly.FromDateTime(DateTime.Today.AddDays(30));}
}
