@page "/accounting/setup"
@attribute [Authorize(Policy=AccountingPermissions.Read)]
@inject HttpClient Http
<PageTitle>Accounting setup</PageTitle>
<article class="card contacts-card"><p class="eyebrow">Accounting</p><h1>Accounting setup</h1><p>Configure the chart of accounts, fiscal calendar, and journals before posting transactions.</p>
@if(_loading){<p role="status">Loading accounting configuration…</p>}else if(_error is not null){<div class="notice notice-error" role="alert">@_error <button type="button" @onclick="Load">Try again</button></div>}else{
<AuthorizeView Policy="@AccountingPermissions.Configure" Context="accountingAuth"><div class="content-grid">
<section><h2>New account</h2><EditForm Model="_account" OnValidSubmit="SaveAccount" FormName="account-editor" Context="accountForm"><DataAnnotationsValidator/><ValidationSummary/><label>Code <InputText @bind-Value="_account.Code"/></label><label>Name <InputText @bind-Value="_account.Name"/></label><label>Type <InputSelect @bind-Value="_account.Type">@foreach(var x in Enum.GetValues<AccountType>()){<option value="@x">@x</option>}</InputSelect></label><label>Normal balance <InputSelect @bind-Value="_account.NormalBalance">@foreach(var x in Enum.GetValues<NormalBalance>()){<option value="@x">@x</option>}</InputSelect></label><label><InputCheckbox @bind-Value="_account.AllowDirectPosting"/> Allow direct posting</label><button disabled="@_saving">Add account</button></EditForm></section>
<section><h2>New journal</h2><EditForm Model="_journal" OnValidSubmit="SaveJournal" FormName="journal-editor"><DataAnnotationsValidator/><ValidationSummary/><label>Code <InputText @bind-Value="_journal.Code"/></label><label>Name <InputText @bind-Value="_journal.Name"/></label><button disabled="@_saving">Add journal</button></EditForm></section>
<section><h2>New fiscal period</h2><EditForm Model="_period" OnValidSubmit="SavePeriod" FormName="period-editor"><DataAnnotationsValidator/><ValidationSummary/><label>Name <InputText @bind-Value="_period.Name"/></label><label>Starts <InputDate @bind-Value="_period.StartsOn"/></label><label>Ends <InputDate @bind-Value="_period.EndsOn"/></label><button disabled="@_saving">Add period</button></EditForm></section>
</div></AuthorizeView>
@if(_message is not null){<div class="notice notice-success" role="status">@_message</div>}
<h2>Chart of accounts</h2>@if(_accounts.Count==0){<p>No accounts configured.</p>}else{<div class="table-scroll" tabindex="0" role="region" aria-label="Chart of accounts"><table><caption>Chart of accounts</caption><thead><tr><th scope="col">Code</th><th scope="col">Name</th><th scope="col">Type</th><th scope="col">Normal balance</th><th scope="col">Posting</th></tr></thead><tbody>@foreach(var x in _accounts){<tr><td>@x.Code</td><td>@x.Name</td><td>@x.Type</td><td>@x.NormalBalance</td><td>@(x.AllowDirectPosting?"Direct":"Control")</td></tr>}</tbody></table></div>}
<h2>Fiscal periods</h2>@if(_periods.Count==0){<p>No periods configured.</p>}else{<div class="table-scroll" tabindex="0" role="region" aria-label="Fiscal periods"><table><caption>Fiscal periods</caption><thead><tr><th scope="col">Name</th><th scope="col">Dates</th><th scope="col">State</th><th scope="col">Action</th></tr></thead><tbody>@foreach(var x in _periods){<tr><td>@x.Name</td><td>@x.StartsOn – @x.EndsOn</td><td>@x.State</td><td><AuthorizeView Policy="@AccountingPermissions.ClosePeriods"><button disabled="@_saving" @onclick="()=>Toggle(x)">@(x.State==FiscalPeriodState.Open?"Close":"Reopen")</button></AuthorizeView></td></tr>}</tbody></table></div>}
<h2>Journals</h2>@if(_journals.Count==0){<p>No journals configured.</p>}else{<div class="table-scroll" tabindex="0" role="region" aria-label="Journals"><table><caption>Journals</caption><thead><tr><th scope="col">Code</th><th scope="col">Name</th><th scope="col">Status</th></tr></thead><tbody>@foreach(var x in _journals){<tr><td>@x.Code</td><td>@x.Name</td><td>@(x.IsActive?"Active":"Inactive")</td></tr>}</tbody></table></div>}}
</article>
@code{private readonly List<AccountDto> _accounts=[];private readonly List<FiscalPeriodDto> _periods=[];private readonly List<JournalDto> _journals=[];private AccountForm _account=new();private JournalForm _journal=new();private PeriodForm _period=new();private bool _loading=true,_saving;private string? _error,_message;protected override Task OnInitializedAsync()=>Load();private async Task Load(){_loading=true;_error=null;try{_accounts.Clear();_accounts.AddRange(await Http.GetFromJsonAsync<List<AccountDto>>("api/v1/accounting/accounts")??[]);_periods.Clear();_periods.AddRange(await Http.GetFromJsonAsync<List<FiscalPeriodDto>>("api/v1/accounting/periods")??[]);_journals.Clear();_journals.AddRange(await Http.GetFromJsonAsync<List<JournalDto>>("api/v1/accounting/journals")??[]);}catch(HttpRequestException){_error="Accounting configuration could not be loaded.";}finally{_loading=false;}}private async Task SaveAccount()=>await Save(()=>Http.PostAsJsonAsync("api/v1/accounting/accounts",new AccountRequest(_account.Code,_account.Name,_account.Type,_account.NormalBalance,_account.AllowDirectPosting)),()=>_account=new(),"Account added.");private async Task SaveJournal()=>await Save(()=>Http.PostAsJsonAsync("api/v1/accounting/journals",new JournalRequest(_journal.Code,_journal.Name)),()=>_journal=new(),"Journal added.");private async Task SavePeriod()=>await Save(()=>Http.PostAsJsonAsync("api/v1/accounting/periods",new FiscalPeriodRequest(_period.Name,_period.StartsOn,_period.EndsOn)),()=>_period=new(),"Fiscal period added.");private async Task Toggle(FiscalPeriodDto x)=>await Save(()=>Http.PostAsJsonAsync($"api/v1/accounting/periods/{x.Id}/{(x.State==FiscalPeriodState.Open?"close":"reopen")}",new AccountingActionRequest(x.ConcurrencyStamp)),()=>{},$"Period {(x.State==FiscalPeriodState.Open?"closed":"reopened")}.");private async Task Save(Func<Task<HttpResponseMessage>> send,Action reset,string message){_saving=true;_error=null;_message=null;try{var response=await send();if(response.IsSuccessStatusCode){reset();_message=message;await Load();}else _error="The change could not be saved. Review the values and try again.";}catch(HttpRequestException){_error="The server could not be reached. Try again.";}finally{_saving=false;}}private sealed class AccountForm{[System.ComponentModel.DataAnnotations.Required]public string Code{get;set;}="";[System.ComponentModel.DataAnnotations.Required]public string Name{get;set;}="";public AccountType Type{get;set;}public NormalBalance NormalBalance{get;set;}public bool AllowDirectPosting{get;set;}=true;}private sealed class JournalForm{[System.ComponentModel.DataAnnotations.Required]public string Code{get;set;}="";[System.ComponentModel.DataAnnotations.Required]public string Name{get;set;}="";}private sealed class PeriodForm{[System.ComponentModel.DataAnnotations.Required]public string Name{get;set;}="";public DateOnly StartsOn{get;set;}=new(DateTime.UtcNow.Year,1,1);public DateOnly EndsOn{get;set;}=new(DateTime.UtcNow.Year,12,31);}}
