@page "/projects/tasks"
@attribute [Authorize(Policy = ProjectsPermissions.Read)]
@using Erp.Abstractions.Organization
@inject IProjectsService Projects
@inject ICompanyUserDirectory CompanyUsers
<PageTitle>Project tasks</PageTitle>
<article class="card entity-page module-workspace"><div class="page-heading"><div><p class="eyebrow">Work management</p><h1>Tasks</h1><p class="muted">Assign and move delivery tasks through their workflow.</p></div></div>
@if (_error is not null) { <p role="alert">@_error</p> }
    <section class="module-panel"><h2>Project</h2><InputSelect @bind-Value="_projectId" @bind-Value:after="LoadAsync"><option value="@Guid.Empty">Choose a project</option>@foreach (var p in _projects) { <option value="@p.Id">@p.Name</option> }</InputSelect></section>
    @if (_projectId != Guid.Empty) { <AuthorizeView Policy="@ProjectsPermissions.Manage" Context="taskManage"><section class="module-panel"><h2>New task</h2><EditForm Model="_form" OnValidSubmit="CreateAsync" FormName="project-task-create"><DataAnnotationsValidator/><div class="form-grid"><label>Title <InputText @bind-Value="_form.Title" maxlength="200"/></label><label>Description <InputText @bind-Value="_form.Description" maxlength="4000"/></label><label>Milestone <InputSelect @bind-Value="_form.MilestoneId"><option value="">No milestone</option>@foreach(var m in _milestones){<option value="@m.Id">@m.Name</option>}</InputSelect></label><label>Assignee <InputSelect @bind-Value="_form.AssignedUserId"><option value="">Unassigned</option>@foreach(var u in _users){<option value="@u.Id">@u.DisplayName</option>}</InputSelect></label><label>Due date <InputDate @bind-Value="_form.DueDate"/></label></div><button disabled="@_saving">Add task</button></EditForm></section></AuthorizeView>
    <section class="module-panel"><h2>Task register</h2>@if(_tasks.Count==0){<p class="empty-state">No tasks for this project.</p>}else{<div class="table-scroll"><table class="data-table"><thead><tr><th>Task</th><th>Milestone</th><th>Assignee</th><th>Due</th><th>Status</th><th>Update</th></tr></thead><tbody>@foreach(var t in _tasks){<tr @key="t.Id"><td>@t.Title</td><td>@_milestones.FirstOrDefault(m=>m.Id==t.MilestoneId)?.Name</td><td>@_users.FirstOrDefault(u=>u.Id==t.AssignedUserId)?.DisplayName</td><td>@(t.DueDate?.ToString("yyyy-MM-dd") ?? "—")</td><td>@t.Status</td><td><AuthorizeView Policy="@ProjectsPermissions.Manage" Context="taskManage">@foreach(var s in NextStatuses(t.Status)){<button class="button button-secondary button-small" disabled="@_saving" @onclick="()=>SetStatusAsync(t,s)">@Action(s)</button>}</AuthorizeView></td></tr>}</tbody></table></div>}</section> }
</article>
@code { private IReadOnlyList<ProjectResponse> _projects=[]; private IReadOnlyList<MilestoneResponse> _milestones=[]; private IReadOnlyList<ProjectTaskResponse> _tasks=[]; private IReadOnlyList<CompanyUserReference> _users=[]; private Guid _projectId; private TaskForm _form=new(); private string? _error; private bool _saving;
protected override async Task OnInitializedAsync(){_projects=await Projects.ListProjectsAsync(CancellationToken.None);_users=await CompanyUsers.ListAsync(CancellationToken.None);if(_projects.Count>0){_projectId=_projects[0].Id;await LoadAsync();}}
private async Task LoadAsync(){if(_projectId!=Guid.Empty){_milestones=await Projects.ListMilestonesAsync(_projectId,CancellationToken.None);_tasks=await Projects.ListTasksAsync(_projectId,null,CancellationToken.None);}}
private async Task CreateAsync(){await SaveAsync(()=>Projects.SaveTaskAsync(null,new(_projectId,_form.MilestoneId,_form.Title,_form.Description,_form.DueDate,ProjectWorkStatus.NotStarted,_form.AssignedUserId),CancellationToken.None));_form=new();}
private Task SetStatusAsync(ProjectTaskResponse t,ProjectWorkStatus s)=>SaveAsync(()=>Projects.SaveTaskAsync(t.Id,new(t.ProjectId,t.MilestoneId,t.Title,t.Description,t.DueDate,s,t.AssignedUserId,t.ConcurrencyStamp),CancellationToken.None));
private async Task SaveAsync(Func<Task<ProjectTaskResponse>> action){_saving=true;_error=null;try{await action();await LoadAsync();}catch(ProjectsValidationException e){_error=string.Join(" ",e.Errors.SelectMany(x=>x.Value));}catch(ProjectsConcurrencyException e){_error=e.Message;}finally{_saving=false;}}
private static IReadOnlyList<ProjectWorkStatus> NextStatuses(ProjectWorkStatus s)=>s switch{ProjectWorkStatus.NotStarted=>[ProjectWorkStatus.InProgress,ProjectWorkStatus.Blocked],ProjectWorkStatus.InProgress=>[ProjectWorkStatus.Completed,ProjectWorkStatus.Blocked],ProjectWorkStatus.Blocked=>[ProjectWorkStatus.InProgress],_=>[]};
private static string Action(ProjectWorkStatus s)=>s switch{ProjectWorkStatus.InProgress=>"Start / resume",ProjectWorkStatus.Completed=>"Complete",ProjectWorkStatus.Blocked=>"Block",_=>s.ToString()};
private sealed class TaskForm{[System.ComponentModel.DataAnnotations.Required,System.ComponentModel.DataAnnotations.StringLength(200)]public string Title{get;set;}="";[System.ComponentModel.DataAnnotations.StringLength(4000)]public string? Description{get;set;}public Guid? MilestoneId{get;set;}public Guid? AssignedUserId{get;set;}public DateOnly? DueDate{get;set;}}
}



