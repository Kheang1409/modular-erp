@page "/inventory/reservations/{Id:guid}"
@attribute [Authorize(Policy = InventoryPermissions.Read)]
@inject HttpClient Http

<PageTitle>Stock reservation</PageTitle>
<article class="card contacts-card">
    @if (_loading) { <p role="status">Loading reservation…</p> }
    else if (_reservation is null) { <p role="alert">Reservation was not found.</p> }
    else
    {
        <p class="eyebrow">Stock reservation</p><h1>@_reservation.ProductId</h1>
        <dl><dt>State</dt><dd>@_reservation.State</dd><dt>Location</dt><dd>@_location</dd><dt>Reserved</dt><dd>@_reservation.Quantity</dd><dt>Consumed</dt><dd>@_reservation.ConsumedQuantity</dd><dt>Remaining</dt><dd>@_reservation.RemainingQuantity</dd><dt>Sales order</dt><dd>@_reservation.ReferenceDocumentId</dd><dt>Created</dt><dd>@_reservation.CreatedAtUtc</dd></dl>
        @if (_reservation.State == ReservationState.Active) { <AuthorizeView Policy="@InventoryPermissions.Reserve"><button type="button" disabled="@_busy" @onclick="Release">Release remaining quantity</button></AuthorizeView> }
        @if (_message is not null) { <p role="status">@_message</p> } @if (_error is not null) { <p role="alert" class="validation-message">@_error</p> }
    }
</article>

@code {
    [Parameter] public Guid Id { get; set; }
    private ReservationDto? _reservation; private string _location = ""; private readonly string _releaseKey = Guid.NewGuid().ToString("N"); private bool _loading = true; private bool _busy; private string? _message; private string? _error;
    protected override async Task OnParametersSetAsync() { _loading = true; try { _reservation = await Http.GetFromJsonAsync<ReservationDto>($"api/v1/inventory/reservations/{Id}"); } catch (HttpRequestException) { _reservation = null; } if (_reservation is not null) { var locations = await Http.GetFromJsonAsync<List<LocationDto>>("api/v1/inventory/locations") ?? []; _location = locations.FirstOrDefault(x => x.Id == _reservation.LocationId) is { } value ? $"{value.Code} — {value.Name}" : _reservation.LocationId.ToString(); } _loading = false; }
    private async Task Release() { _busy = true; _message = null; _error = null; var response = await Http.PostAsJsonAsync($"api/v1/inventory/reservations/{Id}/release", new ReservationActionRequest(_reservation!.ConcurrencyStamp, _releaseKey)); if (response.IsSuccessStatusCode) { _reservation = await response.Content.ReadFromJsonAsync<ReservationDto>(); _message = "Reservation released."; } else _error = await response.Content.ReadAsStringAsync(); _busy = false; }
}
