@namespace Erp.Modules.Sales.Pages
<EditForm Model="Model" OnValidSubmit="Submit" FormName="@FormName"><DataAnnotationsValidator/><ValidationSummary/><div class="form-grid"><label>Customer ID <InputText @bind-Value="Model.CustomerId"/></label><label>Currency <InputText @bind-Value="Model.CurrencyCode"/></label><label>Quotation date <InputDate @bind-Value="Model.QuotationDate"/></label><label>Valid until <InputDate @bind-Value="Model.ValidUntil"/></label><label class="wide">Notes <InputTextArea @bind-Value="Model.Notes"/></label><label class="wide">Terms <InputTextArea @bind-Value="Model.Terms"/></label></div><h2>Lines</h2>@for(var index=0;index<Model.Lines.Count;index++){var line=Model.Lines[index];<fieldset><legend>Line @(index+1)</legend><div class="form-grid"><label>Product ID <InputText @bind-Value="line.ProductId"/></label><label>Quantity <InputNumber @bind-Value="line.Quantity"/></label><label>Unit price <InputNumber @bind-Value="line.UnitPrice"/></label><label>Discount % <InputNumber @bind-Value="line.DiscountPercent"/></label><label>Tax % <InputNumber @bind-Value="line.TaxPercent"/></label><label>Description <InputText @bind-Value="line.Description"/></label></div>@if(Model.Lines.Count>1){<button type="button" @onclick="()=>Remove(line)">Remove line</button>}</fieldset>}<p><button type="button" @onclick="Add">Add line</button> <button type="submit" disabled="@Busy">Save quotation</button></p>@if(Error is not null){<p role="alert">@Error</p>}</EditForm>
@code{[Parameter,EditorRequired]public QuotationForm Model{get;set;}=new();[Parameter]public EventCallback OnSubmit{get;set;}[Parameter]public bool Busy{get;set;}[Parameter]public string? Error{get;set;}[Parameter]public string FormName{get;set;}="quotation";private void Add()=>Model.Lines.Add(new());private void Remove(QuotationLineForm line)=>Model.Lines.Remove(line);private Task Submit()=>OnSubmit.InvokeAsync();}
