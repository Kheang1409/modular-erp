@page "/sales/quotations/{Id:guid}"
@attribute [Authorize(Policy=SalesPermissions.QuotationRead)]
@inject IQuotationService Quotations
<PageTitle>Quotation</PageTitle><article class="card contacts-card">@if(_item is null){<p>Loading or not found...</p>}else{<p class="eyebrow">@_item.State</p><h1>@_item.Number</h1><p>@_item.CustomerName · @_item.QuotationDate · @_item.CurrencyCode</p><table><thead><tr><th>Product</th><th>Quantity</th><th>Price</th><th>Discount</th><th>Tax</th><th>Total</th></tr></thead><tbody>@foreach(var line in _item.Lines){<tr><td>@line.ProductSku — @line.Description</td><td>@line.Quantity @line.UnitCode</td><td>@line.UnitPrice</td><td>@line.DiscountAmount</td><td>@line.TaxAmount</td><td>@line.Total</td></tr>}</tbody></table><dl><dt>Subtotal</dt><dd>@_item.Subtotal</dd><dt>Discount</dt><dd>@_item.DiscountTotal</dd><dt>Tax</dt><dd>@_item.TaxTotal</dd><dt>Total</dt><dd><strong>@_item.Total @_item.CurrencyCode</strong></dd><dt>Base rate</dt><dd>@_item.ExchangeRate @_item.BaseCurrencyCode</dd></dl><p><a href="@($"/sales/quotations/{Id}/edit")">Edit</a> <a href="@($"/sales/quotations/{Id}/transition")">Actions</a> @if(_item.State==QuotationState.Accepted){<a href="@($"/sales/quotations/{Id}/convert")">Create sales order</a>} <a href="/sales/quotations">Back</a></p>}</article>
@code{[Parameter]public Guid Id{get;set;}private QuotationDto? _item;protected override async Task OnParametersSetAsync()=>_item=await Quotations.GetAsync(Id,CancellationToken.None);}
