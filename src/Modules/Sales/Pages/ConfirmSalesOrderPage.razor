@page "/sales/orders/{Id:guid}/confirm"
@attribute [Authorize(Policy=SalesPermissions.OrderConfirm)]
@inject ISalesOrderService Orders
@inject NavigationManager Navigation
<PageTitle>Confirm sales order</PageTitle><article class="card contacts-card"><h1>Confirm sales order</h1>@if(_item is null){<p>Loading...</p>}else{<p>Confirm <strong>@_item.Number</strong>. Its commercial snapshot will remain immutable.</p><button @onclick="Apply">Confirm</button>@if(_error is not null){<p role="alert">@_error</p>}}</article>
@code{[Parameter]public Guid Id{get;set;}private SalesOrderDto? _item;private string? _error;protected override async Task OnParametersSetAsync()=>_item=await Orders.GetAsync(Id,CancellationToken.None);private async Task Apply(){try{await Orders.TransitionAsync(Id,SalesOrderState.Confirmed,_item!.ConcurrencyStamp,CancellationToken.None);Navigation.NavigateTo($"/sales/orders/{Id}");}catch(Exception ex){_error=ex.Message;}}}
