POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=replace-for-shared-environments
POSTGRES_PORT=5432
ERP_PORT=8080
ERP_ADMIN_EMAIL=admin@example.com
ERP_ADMIN_PASSWORD=replace-with-a-long-unique-password
# Production recommendation: require ECDSA publisher signatures and mount public PEM files in the trusted-publishers directory.
Modules__Trust__RequireSignatures=false
Modules__Trust__TrustedKeysPath=.erp/trusted-publishers
MODULE_SIGNATURES_REQUIRED=false
# Production proxy IPs use indexed configuration, for example:
# ReverseProxy__KnownProxies__0=10.0.0.10
# Security__RequireSecureCookies=true
# Optional S3-compatible storage (also set FileStorage__Provider=S3):
# FileStorage__Bucket=erp-files
# FileStorage__ServiceUrl=http://minio:9000
# FileStorage__Region=us-east-1
# FileStorage__AccessKey=replace-me
# FileStorage__SecretKey=replace-me
